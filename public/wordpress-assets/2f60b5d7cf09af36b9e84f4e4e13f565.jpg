                        <td class="price__price">￥{{wp5}}～</td>
                        <td class="price__count"><input type='number' min="0" v-model="wp5Number">個</td>
                      </tr>
                      <tr>
                        <th>カスタム投稿追加</th>
                        <td class="price__description">標準更新機能の他に追加で更新機能を設置</td>
                        <td class="price__price">￥{{wp6}}～</td>
                        <td class="price__count"><input type='number' min="0" v-model="wp6Number">個</td>
                      </tr>
                      <tr>
                        <th>お問合わせフォーム</th>
                        <td class="price__description">お問い合わせフォームの設置</td>
                        <td class="price__price">￥{{wp7}}～</td>
                        <td class="price__count"><input type='number' min="0" v-model="wp7Number">式</td>
                      </tr>
                      <tr>
                        <th>コメント機能追加</th>
                        <td class="price__description">投稿ページへのコメント機能の設置</td>
                        <td class="price__price">￥{{wp8}}～</td>
                        <td class="price__count"><input type='number' min="0" v-model="wp8Number">式</td>
                      </tr>
                    </table>
                    <caption>
                      <ul class="caption">
                      </ul>
                    </caption>
                  </div>
                  <div class="price mt-100">
                    <h3 class="price__title">オプション</h3>
                    <table class="price__table m-24">
                      <tr>
                        <th>アニメーション追加</th>
                        <td class="price__description">
                          Webサイトにリッチなアニメーションを追加
                          <ul>
                            <li>ローディングアニメーション</li>
                            <li>SVGアニメーション</li>
                            <li>スクロール連動アニメーション</li>
