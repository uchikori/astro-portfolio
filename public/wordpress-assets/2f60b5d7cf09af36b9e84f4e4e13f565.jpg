                        <td class="price__price">￥{{wp3}}～</td>
                        <td class="price__count"><input type='number' min="0" v-model="wp3Number">P</td>
                      </tr>
                      <tr>
                        <th>アーカイブページ実装</th>
                        <td class="price__description">更新記事の一覧を表示するページを作成</td>
                        <td class="price__price">￥{{wp4}}～</td>
                        <td class="price__count"><input type='number' min="0" v-model="wp4Number">P</td>
                      </tr>
                      <tr>
                        <th>カスタムフィールド追加</th>
