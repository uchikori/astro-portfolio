# WordPress GraphQL / REST API ベース URL
# 例: https://your-wordpress-site.com/graphql
WORDPRESS_API_URL=

# Contact Form 7 のフォーム ID（WordPress 管理画面の編集 URL から確認）
CONTACT_FORM_ID=

# 1 ページあたりの表示件数（省略時: 12）
WORKS_PER_PAGE=12

# ステージング環境など Basic 認証が必要な場合のみ設定
# WORDPRESS_AUTH_USER=
# WORDPRESS_AUTH_PASSWORD=
