---
const { title = "Astro" } = Astro.props;
import "../styles/style.scss";
import Loader from "../components/common/Loader.astro";
import Aside from "../components/common/Aside.astro";
import Video from "../components/ui/Video.astro";
import Header from "../components/common/Header.astro";
import Menu from "../components/common/Menu.astro";
import Nav from "../components/common/Nav.astro";
import Footer from "../components/common/Footer.astro";
import FresnelBG from "../components/webgl/FresnelBG.astro";
import LoadPP from "../components/webgl/LoadPP.astro";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <script src="../scripts/index.js"></script>
    <title>{title}</title>
    <meta
      name="description"
      content="個人ポートフォリオサイトです。Web制作のスキルや経験を紹介しています。"
    />
    <link
      rel="preload"
      href="/fonts/Orbitron-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Orbitron-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <slot name="head" />
  </head>
  <body data-scroll-trigger="ripple">
    <Loader />
    <div id="globalContainer">
      <Header />

      <!-- <FresnelBG /> -->
      <LoadPP />
      <div id="smooth-wrapper">
        <div id="smooth-content">
          <div id="pageContainer">
            <slot />
          </div>
          <Footer />
          <canvas
            id="canvas"
            data-scroll-trigger="pin"
            data-scroll-trigger-target="body"></canvas>
        </div>
      </div>
    </div>
  </body>

  <style lang="scss">
    @use "../styles/global" as *;
    @use "sass:math";

    html {
      font-size: math.div($root-font-size, 16px) * 100%;
      font-feature-settings: "palt";
      background-color: var(--c-bg);
    }

    body {
      font-family: $base-font;
      font-weight: 500;
      letter-spacing: 0.05em;
      text-size-adjust: 100%;
      -webkit-text-size-adjust: 100%;
      -webkit-font-smoothing: antialiased;
      color: var(--c-text);
      margin: 0;
      background-color: transparent;
    }

    body::-webkit-scrollbar {
      display: none;
    }

    #globalContainer {
      position: relative;
      overflow-x: hidden;
      visibility: hidden;
    }

    #smooth-wrapper {
      // opacity: 0;
    }

    #canvas {
      height: 100svh;
      width: 100vw;
      position: absolute;
      top: 0;
      left: 0;
      z-index: -1;
      background-color: transparent;
    }
  </style>
</html>
