---
const {
  title = "UCHIWA Creative Studio.",
  pageType,
  bodyClass,
  description,
} = Astro.props;
import "../styles/style.scss";
import Loader from "../components/common/Loader.astro";
import Header from "../components/common/Header.astro";
import Footer from "../components/common/Footer.astro";
import LoadPP from "../components/webgl/LoadPP.astro";
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <script src="../scripts/index.js"></script>
    <link
      rel="preload"
      href="/fonts/Orbitron-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Orbitron-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <slot name="head" />
    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-TXSC6XJ");
    </script>
    <!-- End Google Tag Manager -->

    <!-- Google Adsence -->
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3842486595943279"
      crossorigin="anonymous"></script>
    <!-- End google Adsence -->
  </head>
  <body class={bodyClass}>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-TXSC6XJ"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <Loader />
    <div id="globalContainer">
      <Header />

      <!-- <FresnelBG /> -->
      <LoadPP />
      <div id="smooth-wrapper">
        <div id="smooth-content">
          <div id="pageContainer" data-page-type={pageType}>
            <slot />
          </div>
          <Footer />
          <canvas
            id="canvas"
            data-scroll-trigger="pin"
            data-scroll-trigger-target="body"></canvas>
        </div>
      </div>
    </div>
  </body><style lang="scss">
    @use "../styles/global" as *;
    @use "sass:math";

    html {
      font-size: math.div($root-font-size, 16px) * 100%;
      font-feature-settings: "palt";
      background-color: var(--c-bg);
    }

    body {
      font-family: $base-font;
      font-weight: 500;
      letter-spacing: 0.05em;
      text-size-adjust: 100%;
      -webkit-text-size-adjust: 100%;
      -webkit-font-smoothing: antialiased;
      color: var(--c-text);
      margin: 0;
      background-color: transparent;
    }

    body::-webkit-scrollbar {
      display: none;
    }

    #globalContainer {
      position: relative;
      overflow-x: hidden;
      visibility: hidden;
    }

    #smooth-wrapper {
      // opacity: 0;
    }

    #canvas {
      // height: 100svh;
      height: 100lvh;
      width: 100vw;
      position: absolute;
      top: 0;
      left: 0;
      z-index: -1;
      background-color: transparent;
    }
  </style>
</html>
