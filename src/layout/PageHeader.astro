---
const {
  ja,
  en,
  tag,
  title,
  breadcrumbLabel,
  bilingualTitle = true,
} = Astro.props;
import BilingualTitle from "../components/ui/BilingualTitle.astro";
import Breadcrumb from "../components/ui/Breadcrumb.astro";
---

<header class="ly_pageHeader">
  {
    bilingualTitle && (
      <>
        <BilingualTitle ja={ja} en={en} tag={tag} />
        <hr />
      </>
    )
  }
  <Breadcrumb currentLabel={breadcrumbLabel} />
</header>

<style lang="scss">
  @use "../styles/utility" as *;
  @use "../styles/global" as *;

  .ly_pageHeader {
    display: flex;
    flex-direction: column;
    gap: to-rem(40px);
  }
</style>
