            </div>
          </section>
        </div>
      </main>
    </PageWrapper>

    <!-- <Picture
      src={bgAbout}
      formats={["avif", "webp"]}
      widths={[375, 710, 1920]}
      sizes="(max-width: 768px) 100vw, 1920px"
      alt="サンプル画像"
      width={1560}
      height={877}
      loading="lazy"
    /> -->
  </div>
</Base>

<style lang="scss">
  @use "../styles/utility" as *;
  @use "../styles/global" as *;

  .ly_pageMain {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: to-rem(80px) 0;

    @include mq("lg") {
      flex-direction: column;
      align-items: center;
    }
  }

  .bl_walkingMan {
    width: 100%;
    max-width: to-rem(560px);
    aspect-ratio: 1;
    flex-shrink: 1;

    @media (min-width: 960px) {
      width: 45%;
      max-width: to-rem(600px);
      margin-top: to-rem(40px);
    }

    @include mq("lg") {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      transform: none !important;
      width: 100% !important;
      max-width: to-rem(360px) !important;
      margin-inline: auto;
      margin-bottom: to-rem(40px);
    }
  }

  :global(.pin-spacer) {
    @include mq("lg") {
      width: 100% !important;
      height: auto !important;
      padding: 0 !important;
    }
  }

  .bl_page_contents {
    width: 100%;
    max-width: to-rem(760px);
    display: flex;
    flex-direction: column;
    gap: fluid-text(120px, 360px);
    flex-shrink: 1;

    @media (min-width: 960px) {
      width: 50%;
    }
  }

  .bl_data {
    @include mq("md") {
      display: flex;
      flex-direction: column;
      gap: to-rem(16px);
    }
  }

  .bl_section_title {
    font-size: to-rem(20px);
    display: flex;
    gap: to-rem(10px);
    align-items: center;
  }
  .bl_section_contents {
    margin-top: to-rem(24px);
    line-height: 2;
  }
</style>
