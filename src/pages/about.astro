---
import Base from "../layout/Base.astro";
import bgAbout from "../assets/img/about/about_bg.png";
import Picture from "astro/components/Picture.astro";
import CircleImage from "../components/webgl/CircleImage.astro";
import SectionTitle from "../components/ui/SectionTitle.astro";
import Breadcrumb from "../components/ui/Breadcrumb.astro";
import NormalSection from "../components/sections/NormalSection.astro";
---

<Base title="UCHIWAについて" pageType="about" bodyClass="about">
  <div class="hl_contentWidthMiddle">
    <CircleImage image="/img/about/about_bg.png" />
    <div class="ly_pageWrapper">
      <header class="ly_pageHeader">
        <SectionTitle ja="UCHIWAについて" en="ABOUT" tag="h1" />
        <hr />
        <Breadcrumb />
      </header>

      <main class="ly_pageMain">
        <div
          class="bl_walkingMan"
          data-webgl="normal"
          data-model="/model/mixamo_walk.glb"
          data-render-material="toon"
          data-rotation-x="0"
          data-rotation-y="45"
          data-scroll-trigger="pin"
          data-pin-trigger=".ly_pageMain"
        >
        </div>
        <div class="bl_page_contents">
          <NormalSection
            title="UCHIWAについて"
            contents={`北海道札幌市在住の山内友暉と申します。<br /><br />
                        とにかく“作ることが好き”、“デザインが好き”、“コードを書くことが好き”そんな人間です。<br /><br />
                        自分自身の「好き」という感情を原動力に、誰かの「心を動かす」モノを作りたい…<br />
                        そんな野望を胸にお客様と2人3脚で作り上げていくことを心がけています。`}
          />
          <NormalSection
            title="寄り道ばかりのキャリアが、<br/>いまの仕事につながっています。"
            contents={`大学卒業後は東京の商社で、パッケージシステムの営業として働いていました。
                      <br />
                      その後北海道に戻り、ソフトウェア会社で約2年間、SEとしてプロジェクトの管理やシステム導入のサポートに携わりました。
                      <br />
                      <br />
                      分野は違っても、これまでの経験はすべて今の仕事に活きていると感じています。
                      <br />
                      人とお話ししながら想いをくみ取り、まだ言葉になっていないニーズを形にしていくこと。
                      <br />
                      意見が合わないときも、話し合いを重ねてお互いが納得できるところを見つけること。
                      <br />
                      ものづくりは、そうしたやり取りの積み重ねで成り立っているのだと思います。
                      <br />
                      <br />
                      「無駄な経験は一つもない」——そんな実感を持ちながら、会社員として働くかたわら、昔から好きだった“つくること”を諦めきれず、Webの知識や技術を独学で学び続けてきました。
                      独立後は、制作会社様や個人のお客様とのご縁にも恵まれ、現在に至ります。`}
          />
        </div>
      </main>
    </div>
    <!-- <Picture
      src={bgAbout}
      formats={["avif", "webp"]}
      widths={[375, 710, 1920]}
      sizes="(max-width: 768px) 100vw, 1920px"
      alt="サンプル画像"
      width={1560}
      height={877}
      loading="lazy"
    /> -->
  </div>
</Base>

<style lang="scss">
  @use "../styles/utility" as *;
  @use "../styles/global" as *;
  .ly_pageWrapper {
    padding: fluid-text(74px, 200px) 0 to-rem(100px) 0;
    position: relative;
    z-index: 0;
  }

  .ly_pageHeader {
    display: flex;
    flex-direction: column;
    gap: to-rem(40px);
  }

  .ly_pageMain {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: to-rem(80px) 0;

    @include mq("lg") {
      flex-direction: column;
      align-items: center;
    }
  }

  .bl_walkingMan {
    max-width: 80%;
    width: 600px;
    aspect-ratio: 1;
  }

  .bl_page_contents {
    width: 100%;
    max-width: 760px;
    display: flex;
    flex-direction: column;
    gap: fluid-text(120px, 360px);
  }
</style>
