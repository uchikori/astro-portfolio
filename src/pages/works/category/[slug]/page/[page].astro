---
import Base from "../../../../../layout/Base.astro";
import PageWrapper from "../../../../../layout/PageWrapper.astro";
import PageHeader from "../../../../../layout/PageHeader.astro";
import WorksList from "../../../../../components/works/WorksList.astro";
import CategoryNav from "../../../../../components/works/CategoryNav.astro";
import {
  fetchWorkCategories,
  fetchWorks,
  getPaginationPaths,
} from "../../../../../lib/wordpress";
import SEO from "../../../../../components/common/SEO.astro";

export async function getStaticPaths() {
  const categories = await fetchWorkCategories();
  const allPaths = await Promise.all(
    categories.map(async (category) => {
      // カテゴリーごとの記事総数を取得
      const { totalPages } = await fetchWorks({
        page: 1,
        categorySlug: category.slug,
      });
      const pages = getPaginationPaths(totalPages);

      return pages.map((page) => ({
        params: { slug: category.slug, page: String(page) },
        props: { category, page },
      }));
    }),
  );

  return allPaths.flat();
}

const { category, page } = Astro.props;
const pageNumber = Number(page);
const { works, total, totalPages, currentPage } = await fetchWorks({
  page: pageNumber,
  categorySlug: category.slug,
});
const categories = await fetchWorkCategories();
---

<Base pageType="works" bodyClass="works works-category">
  <Fragment slot="head">
    <SEO
      title={`カテゴリー「${category.name}」 | 制作物`}
      description={category.description}
    />
  </Fragment>
  <div class="hl_contentWidthMiddle">
    <PageWrapper>
      <PageHeader
        ja="制作物"
        en={category.name}
        tag="h1"
        breadcrumbLabel={category.name}
      />

      <main class="ly_pageMain">
        <CategoryNav categories={categories} currentSlug={category.slug} />
        <WorksList
          works={works}
          currentPage={currentPage}
          totalPages={totalPages}
          total={total}
          category={category}
        />
      </main>
    </PageWrapper>
  </div>
</Base>

<style lang="scss">
  @use "../../../../../styles/utility" as *;
  @use "../../../../../styles/global" as *;

  .ly_pageMain {
    margin-top: to-rem(80px);
  }
</style>
