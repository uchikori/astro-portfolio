---
import ArrowLink from "../../components/ui/ArrowLink.astro";
import Base from "../../layout/Base.astro";
import CTA from "../../components/sections/CTA.astro";
import PageWrapper from "../../layout/PageWrapper.astro";
import PageHeader from "../../layout/PageHeader.astro";
import Tag from "../../components/ui/Tag.astro";
import Label from "../../components/ui/Label.astro";
import SectionTitle from "../../components/ui/SectionTitle.astro";
import WorkCard from "../../components/works/WorkCard.astro";
import {
  fetchAllWorkIds,
  fetchWorkById,
  fetchAllWorksRaw,
  getWorkCategoryTagUrl,
} from "../../lib/wordpress";
import Picture from "astro/components/Picture.astro";

export async function getStaticPaths() {
  // キャッシュから全 works を取得（ビルド中1回のみ API コール）
  const [ids, allWorks] = await Promise.all([
    fetchAllWorkIds(),
    fetchAllWorksRaw(),
  ]);

  const paths = await Promise.all(
    ids.map(async (id) => {
      const work = await fetchWorkById(id);
      if (!work) return null;

      // 関連 works をキャッシュ済みリストから計算（追加 API コールなし）
      const relatedWorks = allWorks
        .filter(
          (w) =>
            w.id !== id &&
            work.tags.some((tag) => w.tags.some((wTag) => wTag.id === tag.id)),
        )
        .sort(() => Math.random() - 0.5)
        .slice(0, 3);

      return {
        params: { id: String(id) },
        props: { work, relatedWorks },
      };
    }),
  );

  return paths.filter(Boolean);
}

const { work, relatedWorks } = Astro.props;

console.log(work.mockupImageSp.mediaItemUrl);
---

<Base title={work.title} pageType="works-detail" bodyClass="works-detail">
  <div class="hl_contentWidthMiddle">
    <PageWrapper>
      <PageHeader
        ja={work.title}
        en="WORK DETAIL"
        tag="h1"
        breadcrumbLabel={work.title}
        bilingualTitle={false}
      />

      <main class="ly_pageMain">
        <article class="bl_workDetail">
          <header class="bl_workDetail_header">
            {
              work.categories.length > 0 && (
                <ul class="bl_workDetail_categories">
                  {work.categories.map((category) => (
                    <li class="bl_workDetail_categories_item">
                      <a href={getWorkCategoryTagUrl(category.slug)}>
                        <Label label={category.name} fontSize="1.5rem" />
                      </a>
                    </li>
                  ))}
                </ul>
              )
            }

            <SectionTitle title={work.title} tag="h1" />
            <hr />
          </header>
          {
            work.thumbnailUrl && (
              <figure class="bl_workDetail_hero">
                <Picture
                  src={work.thumbnailUrl}
                  formats={["avif", "webp"]}
                  widths={[375, 710, 1420]}
                  sizes="(max-width: 768px) 100vw, 1560px"
                  alt={work.thumbnailAlt || work.title}
                  width={710}
                  height={335}
                  loading="lazy"
                />
              </figure>
            )
          }

          <div class="bl_workDetail_meta">
            {
              work.tags.length > 0 && (
                <ul class="bl_workDetail_tags">
                  {work.tags.map((tag) => (
                    <Tag
                      category={tag.name}
                      href={getWorkCategoryTagUrl(tag.slug)}
                    />
                  ))}
                </ul>
              )
            }

            <time class="bl_workDetail_date font-12-16" datetime={work.date}>
              公開日: {new Date(work.date).toLocaleDateString("ja-JP")}
            </time>
          </div>

          <div class="bl_workDetail_content" set:html={work.content} />

          <div class="bl_workDetail_mockup">
            {
              work.mockupImageSp?.mediaItemUrl && (
                <figure>
                  <Picture
                    src={work.mockupImageSp.mediaItemUrl}
                    formats={["avif", "webp"]}
                    widths={[375, 710, 1420, 1920]}
                    sizes="(max-width: 768px) 100vw, 1920px"
                    alt={work.mockUpImageSp?.altText || work.title}
                    width={710}
                    height={335}
                    loading="lazy"
                  />
                </figure>
              )
            }
          </div>

          <CTA />

          <footer class="bl_workDetail_footer">
            <ArrowLink
              href="/works"
              text="制作物一覧へ戻る"
              fontSize="1.5rem"
              svgWidth="3rem"
            />
          </footer>
        </article>

        <aside class="bl_workDetail_related">
          <h2 class="bl_workDetail_relatedTitle font-16-24">関連制作物</h2>
          {
            relatedWorks.length > 0 ? (
              <ul class="bl_workDetail_relatedGrid">
                {relatedWorks.map((relatedWork) => (
                  <li class="bl_workDetail_relatedItem">
                    <WorkCard work={relatedWork} />
                  </li>
                ))}
              </ul>
            ) : (
              <p class="font-12-16">同一タグに属する関連制作物がありません。</p>
            )
          }
        </aside>
      </main>
    </PageWrapper>
  </div>
</Base>

<style lang="scss">
  @use "../../styles/utility" as *;
  @use "../../styles/global" as *;

  .ly_pageMain {
    margin-top: to-rem(80px);
    display: flex;
    flex-direction: column;
    gap: to-rem(80px);
  }

  .bl_workDetail {
    display: flex;
    flex-direction: column;
    gap: to-rem(40px);

    &_header {
      display: flex;
      flex-direction: column;
      gap: to-rem(16px);
    }

    &_hero {
      margin: 0;
      width: 100%;
      aspect-ratio: 2 / 1;
      overflow: hidden;

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }

    &_tags {
      display: flex;
      flex-wrap: wrap;
      gap: to-rem(16px);
      list-style: none;
      padding: 0;
      margin: 0;
    }

    &_date {
      color: #8b8b8b;
    }

    &_meta {
      display: flex;
      align-items: center;
      gap: fluid-text(24px, 40px);
      flex-wrap: wrap;
    }

    &_content {
      font-family: "Noto Sans JP", sans-serif;
      line-height: 2;
      width: calc(358 / 390) * 100%;
      margin-inline: auto;
      max-width: to-rem(760px);
      :global(*) {
        margin-top: 1.8em;
      }

      :global(h2) {
        font-size: fluid-text(24px, 32px);
        font-weight: 500;
      }

      :global(h3) {
        font-size: fluid-text(20px, 28px);
        font-weight: 500;
      }

      :global(table) {
        font-size: 1rem;
        :global(td) {
          vertical-align: top;
          // font-family: "Noto Sans JP", sans-serif;
          padding: to-rem(24px) to-rem(10px);
          &:nth-child(1) {
            width: 30%;
          }
        }
      }

      :global(img) {
        max-width: 100%;
        height: auto;
      }

      :global(p) {
        // font-family: "Noto Sans JP", sans-serif;
        line-height: 2;
      }

      :global(a) {
        text-decoration: underline;
        color: $c-white;
      }
    }

    &_footer {
      display: flex;
      margin-top: to-rem(40px);
      padding-top: to-rem(40px);
      border-top: solid 1px var(--c-text);
    }

    &_back {
      color: var(--c-text);
    }

    &_related {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      gap: fluid-text(16px, 32px);
    }

    &_relatedTitle {
      margin: 0 0 to-rem(16px);
    }

    &_relatedGrid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(to-rem(300px), 1fr));
      gap: to-rem(40px);
      list-style: none;
      padding: 0;
      margin: 0;

      @include mq(md) {
        grid-template-columns: 1fr;
        gap: to-rem(24px);
      }
    }

    &_relatedItem {
      width: 100%;
      min-width: 0;
    }
  }
</style>
