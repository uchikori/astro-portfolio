---
import Base from "../../layout/Base.astro";
import PageWrapper from "../../layout/PageWrapper.astro";
import PageHeader from "../../layout/PageHeader.astro";
import Tag from "../../components/ui/Tag.astro";
import {
  fetchAllWorkIds,
  fetchWorkById,
  getWorkCategoryTagUrl,
} from "../../lib/wordpress";

export async function getStaticPaths() {
  const ids = await fetchAllWorkIds();

  const paths = await Promise.all(
    ids.map(async (id) => {
      const work = await fetchWorkById(id);
      if (!work) return null;

      return {
        params: { id: String(id) },
        props: { work },
      };
    }),
  );

  return paths.filter(Boolean);
}

const { work } = Astro.props;
---

<Base title={work.title} pageType="works-detail" bodyClass="works-detail">
  <div class="hl_contentWidthMiddle">
    <PageWrapper>
      <PageHeader ja={work.title} en="WORK DETAIL" tag="h1" />

      <main class="ly_pageMain">
        <article class="bl_workDetail">
          {
            work.thumbnailUrl && (
              <figure class="bl_workDetail_hero">
                <img
                  src={work.thumbnailUrl}
                  alt={work.thumbnailAlt || work.title}
                  width={1200}
                  height={600}
                  loading="eager"
                  decoding="async"
                />
              </figure>
            )
          }

          {
            work.categories.length > 0 && (
              <ul class="bl_workDetail_tags">
                {work.categories.map((category) => (
                  <Tag
                    category={category.name}
                    href={getWorkCategoryTagUrl(category.slug)}
                  />
                ))}
              </ul>
            )
          }

          <time class="bl_workDetail_date font-12-16" datetime={work.date}>
            公開日: {new Date(work.date).toLocaleDateString("ja-JP")}
          </time>

          <div class="bl_workDetail_content font-16-20" set:html={work.content} />

          <footer class="bl_workDetail_footer">
            <a href="/works" class="bl_workDetail_back font-12-16">
              制作物一覧へ戻る
            </a>
          </footer>
        </article>

        <aside class="bl_workDetail_related">
          <h2 class="bl_workDetail_relatedTitle font-16-24">関連制作物</h2>
          <p class="font-12-16">
            同カテゴリーの制作物は
            {
              work.categories[0] && (
                <a href={getWorkCategoryTagUrl(work.categories[0].slug)}>
                  {work.categories[0].name}
                </a>
              )
            }
            一覧からご覧ください。
          </p>
        </aside>
      </main>
    </PageWrapper>
  </div>
</Base>

<style lang="scss">
  @use "../../styles/utility" as *;
  @use "../../styles/global" as *;

  .ly_pageMain {
    margin-top: to-rem(80px);
    display: flex;
    flex-direction: column;
    gap: to-rem(80px);
  }

  .bl_workDetail {
    display: flex;
    flex-direction: column;
    gap: to-rem(40px);

    &_hero {
      margin: 0;
      width: 100%;
      aspect-ratio: 2 / 1;
      overflow: hidden;

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }

    &_tags {
      display: flex;
      flex-wrap: wrap;
      gap: to-rem(16px);
      list-style: none;
      padding: 0;
      margin: 0;
    }

    &_date {
      color: #8b8b8b;
    }

    &_content {
      line-height: 2;

      :global(h2),
      :global(h3) {
        margin: to-rem(40px) 0 to-rem(20px);
      }

      :global(p) {
        margin: 0 0 to-rem(24px);
      }

      :global(img) {
        max-width: 100%;
        height: auto;
      }
    }

    &_footer {
      margin-top: to-rem(40px);
      padding-top: to-rem(40px);
      border-top: solid 1px var(--c-text);
    }

    &_back {
      color: var(--c-text);
    }

    &_relatedTitle {
      margin: 0 0 to-rem(16px);
    }
  }
</style>
