---
import Base from "../../../layout/Base.astro";
import PageWrapper from "../../../layout/PageWrapper.astro";
import PageHeader from "../../../layout/PageHeader.astro";
import BlogCard from "../../../components/blog/BlogCard.astro";
import BlogSidebar from "../../../components/blog/BlogSidebar.astro";
import Pagination from "../../../components/ui/Pagination.astro";
import {
  fetchBlogCategories,
  fetchBlogPosts,
  fetchWebTipsClasses,
  getBlogListUrl,
  getPaginationPaths,
} from "../../../lib/wordpress";
import BlogLayout from "../../../components/blog/BlogLayout.astro";
import SEO from "../../../components/common/SEO.astro";

export async function getStaticPaths() {
  const { totalPages } = await fetchBlogPosts({ page: 1 });
  // 2ページ目以降のパス用の配列を取得する [2,3,4,5,...]
  const pages = getPaginationPaths(totalPages);

  return pages.map((page) => ({
    params: { page: String(page) },
  }));
}

const page = Number(Astro.params.page ?? 1);
const { posts, total, totalPages, currentPage } = await fetchBlogPosts({
  page,
});

// カテゴリーとランキングの集計
const categories = await fetchWebTipsClasses();
---

<Base pageType="web-tips" bodyClass="web-tips">
  <Fragment slot="head">
    <SEO
      title="ブログ記事一覧"
      description="Webサイト制作に関するちょっとしたヒントや、デザインの考え方、日々の出来事などを発信しています。"
    />
  </Fragment>
  <div class="hl_contentWidthMiddle">
    <PageWrapper>
      <PageHeader ja="ブログ記事一覧" en="BLOG" tag="h1" />

      <main class="ly_pageMain">
        <BlogLayout
          posts={posts}
          categories={categories}
          currentPage={currentPage}
          totalPages={totalPages}
        />
      </main>
    </PageWrapper>
  </div>
</Base>

<style lang="scss">
  @use "../../../styles/utility" as *;
  @use "../../../styles/global" as *;

  .ly_pageMain {
    margin-top: to-rem(80px);
  }

  .bl_blogLayout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) to-rem(320px);
    gap: to-rem(32px);
    align-items: start;

    @include mq("lg") {
      grid-template-columns: 1fr;
    }
  }

  .bl_blogGrid {
    min-width: 0;

    &_head {
      margin-bottom: to-rem(20px);
      color: rgba(255, 255, 255, 0.75);
    }

    &_list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: to-rem(24px);

      @include mq("md") {
        grid-template-columns: 1fr;
      }
    }

    &_item {
      min-width: 0;
    }
  }
</style>
