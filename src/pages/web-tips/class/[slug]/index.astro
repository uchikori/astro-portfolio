---
import Base from "../../../../layout/Base.astro";
import PageWrapper from "../../../../layout/PageWrapper.astro";
import PageHeader from "../../../../layout/PageHeader.astro";
import BlogCard from "../../../../components/blog/BlogCard.astro";
import BlogSidebar from "../../../../components/blog/BlogSidebar.astro";
import Pagination from "../../../../components/ui/Pagination.astro";
import {
  fetchAllBlogPosts,
  buildWebTipsClasses,
  getBlogListUrl,
  fetchWebTipsClasses,
  fetchBlogPosts,
} from "../../../../lib/wordpress";
import CircleImage from "../../../../components/webgl/CircleImage.astro";
import BlogLayout from "../../../../components/blog/BlogLayout.astro";

export async function getStaticPaths() {
  const classes = await fetchWebTipsClasses();

  return classes.map((cls) => {
    return {
      params: {
        slug: cls.slug,
      },
      props: {
        cls,
      },
    };
  });
}

const page = 1;

const { cls } = Astro.props;
const { posts, total, totalPages, currentPage } = await fetchBlogPosts({
  page,
  categorySlug: cls.slug,
});

// カテゴリーとランキングの集計
const categories = await fetchWebTipsClasses();
---

<Base title="ブログ記事一覧" pageType="web-tips" bodyClass="web-tips">
  <div class="hl_contentWidthMiddle">
    <CircleImage image="/img/works/works_bg.webp" />
    <PageWrapper>
      <PageHeader
        ja="ブログ記事一覧"
        en="BLOG"
        tag="h1"
        breadcrumbLabel={cls.name}
      />

      <main class="ly_pageMain">
        <BlogLayout
          posts={posts}
          categories={categories}
          currentPage={currentPage}
          totalPages={totalPages}
          category={cls}
        />
      </main>
    </PageWrapper>
  </div>
</Base>

<style lang="scss">
  @use "../../../../styles/utility" as *;
  @use "../../../../styles/global" as *;

  .bl_blogLayout {
    margin-inline: auto;
    max-width: to-rem(1200px);
    display: flex;
    gap: to-rem(32px);
    align-items: start;
    justify-content: space-between;

    @include mq("lg") {
      flex-direction: column;
      gap: to-rem(64px);
    }
  }

  .bl_blogGrid {
    width: calc(800 / 1280) * 100%;
    flex-shrink: 0;
    @include mq("lg") {
      width: 100%;
    }

    &_head {
      margin-bottom: to-rem(20px);
      color: rgba(255, 255, 255, 0.75);
    }

    &_list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(to-rem(300px), 1fr));
      gap: to-rem(40px);

      @include mq("md") {
        grid-template-columns: 1fr;
      }
    }

    &_item {
      min-width: 0;
    }
  }
</style>
