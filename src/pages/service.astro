---
import Base from "../layout/Base.astro";
import Picture from "astro/components/Picture.astro";
import CircleImage from "../components/webgl/CircleImage.astro";
import PageHeader from "../layout/PageHeader.astro";
import PageWrapper from "../layout/PageWrapper.astro";
import SectionTitle from "../components/ui/SectionTitle.astro";
import bgService from "../assets/img/service/service_bg.png";
import CardWithNumber from "../components/ui/CardWithNumber.astro";

import CheckIcon from "../assets/img/icon/check.svg";
import FlowItem from "../components/ui/FlowItem.astro";
import FaqItem from "../components/ui/FaqItem.astro";
import Icon from "../components/ui/Icon.astro";
import Banner from "../components/ui/Banner.astro";
const uniqueId = `clip_${Math.floor(Math.random() * 100000000)}`;
import MailIcon from "../assets/img/icon/mail.svg";
import CalculateIcon from "../assets/img/icon/calculator.svg";
import Label from "../components/ui/Label.astro";
import CTA from "../components/sections/CTA.astro";
import SEO from "../components/common/SEO.astro";
---

<Base pageType="service" bodyClass="service">
  <Fragment slot="head">
    <SEO
      title="事業内容"
      description="Webを中心に「コンセプトメイキング」「デザイン」「コーディング」等のサイト制作全般の業務を承っております"
    />
  </Fragment>
  <div class="hl_contentWidthMiddle">
    <CircleImage image="/img/service/service_bg.webp" />
    <PageWrapper>
      <PageHeader ja="事業内容" en="service" tag="h1" />

      <main class="ly_pageMain">
        <section class="bl_section concept">
          <span
            class="bl_section_decorativeText hl_accentFont"
            data-scroll-trigger="pin"
            data-pin-trigger=".bl_section.concept"
            data-pin-start="top 20%"
            data-pin-end="bottom 20%"
            aria-hidden="true"
          >
            concept
          </span>
          <SectionTitle
            title="Webサイトは「作るもの」ではなく、<br />事業を前に進めるための仕組みです。"
            tag="h2"
          />
          <p class="bl_section_contents">
            事業の想いはあるのに、<br />
            それがうまく伝わらないと感じたことはありませんか。<br />
            <br />
            いまや誰でもホームページを持てる時代になりました。<br />
            ノーコードツールを使えば、見た目だけなら簡単に整えられます。<br />
            それでも「問い合わせが来ない」「価値が伝わらない」<br />
            そんな悩みを抱える方は少なくありません。<br />
            <br />
            私が考えるWebデザインは、<br />
            単にサイトを作ることでも、綺麗に見せることでもありません。<br />
            何のために、誰に向けて、何を届けるのか。<br />
            その整理から始めて、はじめて“伝わるサイト”になります。<br />
            UCHIWA Creative Studioでは表現の前にコンセプト設計を行い、<br />
            お客様のサービスの価値が正しく届くWebサイトを制作しています。
          </p>
        </section>
        <section class="bl_section issue">
          <span
            class="bl_section_decorativeText hl_accentFont"
            data-scroll-trigger="pin"
            data-pin-trigger=".bl_section.issue"
            data-pin-start="top 20%"
            data-pin-end="bottom 20%"
            aria-hidden="true"
          >
            issue
          </span>
          <SectionTitle
            title="Webサイトについて、こんな悩みはありませんか？"
            tag="h2"
          />
          <ul class="bl_cardList">
            <CardWithNumber
              content="何を載せればよいのか分からず、制作の話が前に進まない"
            />
            <CardWithNumber
              content="情報を整理できず、文章や構成を決められない"
            />
            <CardWithNumber
              content="専門用語が多く、制作会社とのやり取りに不安がある"
            />
            <CardWithNumber
              content="公開後の更新方法が分からず、サイトが放置気味になっている"
            />
            <CardWithNumber
              content="自分たちで内容を修正したいが、触るのが怖い"
            />
            <CardWithNumber content="WordPressやECの管理・保守に不安がある" />
            <CardWithNumber
              content="サイトが古く感じるが、どこを直せばいいか判断できない"
            />
            <CardWithNumber
              content="既存サービス（Wix / ページビルダー等）から移行したい"
            />
          </ul>
        </section>
        <section class="bl_section organize">
          <span
            class="bl_section_decorativeText hl_accentFont"
            data-scroll-trigger="pin"
            data-pin-trigger=".bl_section.organize"
            data-pin-start="top 20%"
            data-pin-end="bottom 20%"
            aria-hidden="true"
          >
            organize
          </span>
          <SectionTitle title="作る前に、整理するところから始めます" tag="h2" />
          <p class="bl_section_contents">
            Webサイトの成果は、デザインや技術よりも<br />
            「何のために作るのか」が明確かどうかで大きく変わります。<br />
            UCHIWA Creative Studioでは、いきなり制作に入るのではなく、<br />
            誰に・何を・どのように届けるのかを整理する<br />
            コンセプト設計からスタートします。
          </p>
        </section>
        <section class="bl_section services">
          <span
            class="bl_section_decorativeText hl_accentFont"
            data-scroll-trigger="pin"
            data-pin-trigger=".bl_section.services"
            data-pin-start="top 20%"
            data-pin-end="bottom 20%"
            aria-hidden="true">services</span
          >
          <SectionTitle title="提供サービス" tag="h2" />
          <ul class="bl_serviceList">
            <li class="bl_serviceItem bl_serviceList_item">
              <div class="bl_serviceItem_header">
                <span class="bl_serviceItem_num hl_accentFont"></span>
                <Icon class="bl_serviceItem_icon" icon="web" />
              </div>
              <div class="bl_serviceItem_contents">
                <h3 class="bl_serviceItem_title font-24-32">
                  コーポレートサイト制作
                </h3>
                <p class="bl_serviceItem_contents_description">
                  はじめてのホームページ制作やリニューアルに。<br />
                  更新しやすく、社内で運用できるサイトを構築します。
                </p>
              </div>
              <div class="bl_serviceItem_recommended">
                <Label label="こんな方向け：" fontSize="1rem;" />
                <p class="bl_serviceItem_recommended_text">
                  中小企業・店舗・個人事業
                </p>
              </div>
              <hr />

              <ul class="bl_serviceItem_details">
                <li class="bl_serviceItem_details_item">
                  <CheckIcon />
                  WordPress構築
                </li>
                <li class="bl_serviceItem_details_item">
                  <CheckIcon />
                  スマホ対応
                </li>
                <li class="bl_serviceItem_details_item">
                  <CheckIcon />
                  更新マニュアル
                </li>
              </ul>
            </li>
            <li class="bl_serviceItem bl_serviceList_item">
              <div class="bl_serviceItem_header">
                <span class="bl_serviceItem_num hl_accentFont"></span>
                <Icon class="bl_serviceItem_icon" icon="lightning" />
              </div>
              <div class="bl_serviceItem_contents">
                <h3 class="bl_serviceItem_title font-24-32">
                  高速サイト構築（Jamstack / Headless CMS）
                </h3>
                <p class="bl_serviceItem_contents_description">
                  表示速度・セキュリティ・保守性に優れた次世代型Webサイト。<br
                  />
                  改ざんリスクを抑えながら、CMSによる更新も可能です。
                </p>
              </div>
              <div class="bl_serviceItem_recommended">
                <Label label="こんな方向け：" fontSize="1rem;" />
                <p class="bl_serviceItem_recommended_text">
                  IT企業・採用サイト・ブランディングサイト
                </p>
              </div>
              <hr />

              <ul class="bl_serviceItem_details">
                <li class="bl_serviceItem_details_item">
                  <CheckIcon />
                  Jamstack / Headless CMS
                </li>
                <li class="bl_serviceItem_details_item">
                  <CheckIcon />
                  高速静的ホスティング（Vercel / Netlify 等）
                </li>
                <li class="bl_serviceItem_details_item">
                  <CheckIcon />
                  高セキュリティ
                </li>
              </ul>
            </li>
            <li class="bl_serviceItem bl_serviceList_item">
              <div class="bl_serviceItem_header">
                <span class="bl_serviceItem_num hl_accentFont"></span>
                <Icon class="bl_serviceItem_icon" icon="cart" />
              </div>
              <div class="bl_serviceItem_contents">
                <h3 class="bl_serviceItem_title font-24-32">
                  ECサイト制作（Welcart）
                </h3>
                <p class="bl_serviceItem_contents_description">
                  Shopifyの月額費用や販売手数料を抑え、<br />
                  自社に最適化したオリジナルECサイトを構築します。
                </p>
              </div>
              <div class="bl_serviceItem_recommended">
                <Label label="こんな方向け：" fontSize="1rem;" />
                <p class="bl_serviceItem_recommended_text">
                  小規模ブランド・自社商品販売
                </p>
              </div>
              <hr />

              <ul class="bl_serviceItem_details">
                <li class="bl_serviceItem_details_item">
                  <CheckIcon />
                  WordPress + Welcart
                </li>
                <li class="bl_serviceItem_details_item">
                  <CheckIcon />
                  ランニングコスト削減
                </li>
                <li class="bl_serviceItem_details_item">
                  <CheckIcon />
                  カスタマイズ性
                </li>
              </ul>
            </li>
            <li class="bl_serviceItem bl_serviceList_item">
              <div class="bl_serviceItem_header">
                <span class="bl_serviceItem_num hl_accentFont"></span>
                <Icon class="bl_serviceItem_icon" icon="config" />
              </div>
              <div class="bl_serviceItem_contents">
                <h3 class="bl_serviceItem_title font-24-32">
                  運用・改善サポート
                </h3>
                <p class="bl_serviceItem_contents_description">
                  公開後の更新方法レクチャーや改善提案までサポートします。<br />
                  Webサイトを“作って終わり”にしません。
                </p>
              </div>
              <div class="bl_serviceItem_recommended">
                <Label label="こんな方向け：" fontSize="1rem;" />
                <p class="bl_serviceItem_recommended_text">全てのお客様</p>
              </div>
              <hr />

              <ul class="bl_serviceItem_details">
                <li class="bl_serviceItem_details_item">
                  <CheckIcon />
                  更新レクチャー
                </li>
                <li class="bl_serviceItem_details_item">
                  <CheckIcon />
                  アクセス解析
                </li>
                <li class="bl_serviceItem_details_item">
                  <CheckIcon />
                  改善提案
                </li>
              </ul>
            </li>
          </ul>
        </section>
        <section class="bl_section flow">
          <span
            class="bl_section_decorativeText hl_accentFont"
            data-scroll-trigger="pin"
            data-pin-trigger=".bl_section.flow"
            data-pin-start="top 20%"
            data-pin-end="bottom 20%"
            aria-hidden="true"
          >
            flow
          </span>
          <SectionTitle title="制作の流れ" tag="h2" />
          <ul class="bl_flowList">
            <FlowItem
              icon="web"
              title="お問い合わせ・初回ヒアリング"
              description={`まずは現在の状況やお困りごとをお聞きします。<br />
              まだ内容が固まっていなくても問題ありません。<br />
              「何を作ればよいか分からない」という段階からでもご相談いただけます。`}
              notes={`※オンライン（Google Meet等）またはテキストでのやり取りに対応しています。`}
            />
            <FlowItem
              icon="compass"
              title="方向性の整理・コンセプト設計"
              description={`ヒアリング内容をもとに、誰に向けたサイトなのか／何を伝えるべきか／どのような構成が適切かを整理します。<br />
              この段階で、WordPress・Jamstack・ECサイトなどどの構築方法が適しているかも含めてご提案します。`}
            />
            <FlowItem
              icon="document"
              title="構成提案・お見積もり"
              description={`サイトマップ（ページ構成）と制作方針をご提示します。<br />
              制作内容が明確になった段階で、正式なお見積もりをご案内いたします。`}
              notes={`※ご不明点があれば、この時点で遠慮なくご相談ください。ご納得いただいた場合のみ、制作へ進みます。`}
            />
            <FlowItem
              icon="design"
              title="デザイン制作"
              description={`構成をもとに、実際のデザインを制作します。<br />
              全体のトーンや情報の見せ方を確認しながら進めていきます。<br />
              確認・修正のやり取りを重ね、完成形に近づけていきます。`}
            />
            <FlowItem
              icon="code"
              title="開発・実装"
              description={`デザインをもとにコーディング・システム構築を行います。<br />
              WordPressやCMSの組み込み、EC機能の設定などもこの工程で行います。`}
              notes={`テスト環境をご用意し、公開前に実際の動作をご確認いただけます。`}
            />
            <FlowItem
              icon="rocket"
              title="公開・操作レクチャー"
              description={`本番環境へ公開を行います。<br />
              あわせて、更新方法や記事投稿の手順を分かりやすくご説明します。<br />
              「触るのが不安」という方でも安心して運用できるようサポートします。`}
            />
            <FlowItem
              icon="handshake"
              title="公開後のサポート"
              description={`公開して終わりではなく、必要に応じて改善のご相談や軽微な修正にも対応いたします。<br />
              運用の中で出てくる疑問点についてもお気軽にご連絡ください。`}
            />
          </ul>
        </section>
        <section class="bl_section faq">
          <span
            class="bl_section_decorativeText hl_accentFont"
            data-scroll-trigger="pin"
            data-pin-trigger=".bl_section.faq"
            data-pin-start="top 20%"
            data-pin-end="bottom 20%"
            aria-hidden="true"
          >
            faq
          </span>
          <SectionTitle title="よくあるご質問" tag="h2" />
          <ul class="bl_faqList">
            <FaqItem
              question="相談だけでも大丈夫ですか?"
              answer="はい、ご相談だけでも問題ありません。お聞きしたいお悩みや状況、まだ内容が固まっていなくても丁寧にお伺いいたしますので、まずはお気軽にお問い合わせください。"
            />
            <FaqItem
              question="費用はどのタイミングで発生しますか？"
              answer="サイトの方向性を整理し、大まかな構成（仕様）が固まって「正式にご契約」となった段階で発生します。初回のご相談や、お見積もり・構成のご提案までは無料で対応しております。費用が発生する前に必ず確認を挟みますので、ご安心ください。"
            />
            <FaqItem
              question="どの構築方法を選べばいいか分かりません"
              answer="お客さまの目的や予算、今後の運用体制に合わせて最適な方法をご提案します。「Webの知識がないから選べない」という状態でも全く問題ありません。ヒアリングを通じて、メリット・デメリットを分かりやすく丁寧にご説明いたします。"
            />
            <FaqItem
              question="更新は自分たちでできますか？"
              answer="はい、お知らせやブログなど、ご自身で簡単に更新できるシステム（CMS）を導入可能です。ただし、サイト全体を自由に変更できるようにすると、デザインが崩れる原因や構築コストが高くなるリスクがあります。「どこを自分たちで更新したいか」を事前にすり合わせ、最適な範囲をご提案します。"
            />
            <FaqItem
              question="原稿や写真がなくても依頼できますか？"
              answer="はい、素材が揃っていない状態でもご依頼いただけます。その場合、フリーの高品質な素材写真を使用するか、プロのカメラマンによる撮影（別途費用）をご提案させていただきます。テキストについてもヒアリングを元にこちらで作成をサポートいたしますので、まずは手ぶらでご相談ください。"
            />
            <FaqItem
              question="制作期間はどれくらいですか？"
              answer="制作するサイトの規模や機能によって異なります。一般的なコーポレートサイトであれば、およそ1ヶ月〜3ヶ月が目安です。お急ぎの場合や、具体的な公開希望日がある場合は、スケジュールを調整できる場合もございますので事前にご相談ください。"
            />
            <FaqItem
              question="公開後のサポートはありますか？"
              answer="はい、ご希望に合わせて「月額保守プラン」をご用意しております。定期的なメンテナンスやトラブル対応、軽微な修正などをサポートいたします。なお、保守契約を結ばれていない場合でも対応は可能ですが、その都度スポット（有償）でのご対応となります。"
            />
            <FaqItem
              question="集客やSEO対策もお願いできますか？"
              answer="基本的なSEO対策（検索エンジンに認識されやすい正しいサイト構造の設計など）は標準で対応しております。ただし、特定のキーワードで上位表示を確約するような「高度なSEOコンサルティング」や「継続的な集客マーケティング」につきましては専門外となるため、専門のパートナー企業様をご紹介するか、要件定義の範囲内でのアドバイスに留めさせていただいております。"
            />
          </ul>
        </section>
        <CTA />
      </main>
    </PageWrapper>
  </div>
</Base>

<style lang="scss">
  @use "../styles/utility" as *;
  @use "../styles/global" as *;

  .hl_contentWidthMiddle {
    position: relative;
    isolation: isolate;
  }

  .bl_section {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: fluid-text(40px, 80px);
    position: relative;
    &_decorativeText {
      display: inline-block;
      text-transform: uppercase;
      font-size: fluid-text(56px, 200px);
      line-height: 1;
      color: var(--c-text);
      pointer-events: none;
      // mix-blend-mode: overlay;
      opacity: 0.08;
    }
    &.concept {
      .bl_section_decorativeText {
        position: absolute;
        top: 0;
        left: 0;
        transform: translateY(-50%);
        z-index: 0;

        @include mq("md") {
          position: relative;
          transform: none;
        }
      }
    }
    &.issue {
      align-items: center;
      margin-top: fluid-text(120px, 360px);
      .bl_section_decorativeText {
        text-align: center;
      }
    }
    &.organize {
      align-items: center;
      margin-top: fluid-text(120px, 360px);
      .bl_section_decorativeText {
        text-align: center;
      }
    }
    &.services {
      align-items: center;
      margin-top: fluid-text(120px, 360px);
      .bl_section_decorativeText {
        text-align: center;
      }
    }
    &.flow {
      align-items: center;
      margin-top: fluid-text(120px, 360px);
      .bl_section_decorativeText {
        text-align: center;
      }
    }
    &.faq {
      align-items: center;
      margin-top: fluid-text(120px, 360px);
      .bl_section_decorativeText {
        text-align: center;
      }
    }
    &.banner {
      align-items: center;
      margin-top: fluid-text(120px, 360px);
      .bl_section_contents {
        text-align: center;
        @include mq("md") {
          text-align: left;
        }
      }
    }

    &_contents {
      line-height: 2;
    }

    &_banner {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(to-rem(300px), 1fr));
      gap: to-rem(40px);
    }
  }

  .bl_cardList {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(to-rem(300px), 1fr));
    gap: fluid-text(32px, 80px) fluid-text(32px, 40px);
    @include mq("lg") {
      grid-template-columns: repeat(auto-fit, minmax(to-rem(163px), 1fr));
    }
  }

  .bl_serviceList {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(to-rem(500px), 1fr));
    gap: to-rem(80px);
    @include mq("md") {
      grid-template-columns: 1fr;
      gap: to-rem(120px);
    }
  }

  .bl_serviceItem {
    padding: to-rem(32px) to-rem(24px) to-rem(40px);
    border-top: solid 2px var(--c-text);
    display: flex;
    flex-direction: column;
    gap: to-rem(24px);

    counter-increment: number;
    &_header {
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: var(--c-bg);
    }
    &_num {
      &:before {
        content: "0" counter(number) " ";
        font-size: to-rem(56px);
        color: var(--c-text);
        line-height: 1;
      }
    }
    &_contents {
      font-family: "Noto sans JP", sans-serif;
      display: flex;
      flex-direction: column;
      gap: to-rem(24px);
    }
    &_title {
      font-weight: 500;
    }
    &_description {
      font-size: 1rem;
    }
    &_recommended {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: to-rem(12px);
      &_title {
        display: inline-block;
        font-weight: 500;
        font-size: 1rem;
        color: var(--c-text);
        padding: to-rem(4px) to-rem(8px);
        background: var(--c-orange);
        border-radius: to-rem(4px);
      }
      &_text {
        font-size: 1rem;
      }
    }
    &_details {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: to-rem(10px);
      &_item {
        font-size: to-rem(12px);
        display: flex;
        align-items: center;
        gap: 4px;
      }
    }
  }

  .bl_flowList {
    width: calc(358 / 390) * 100%;
    margin-inline: auto;
    max-width: to-rem(940px);
  }

  .bl_faqList {
    width: calc(358 / 390) * 100%;
    margin-inline: auto;
