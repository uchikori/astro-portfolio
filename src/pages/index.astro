---
import Base from "../layout/Base.astro";
import Kv from "../components/sections/Kv.astro";
import Fv from "../components/sections/Fv.astro";
import Reflect from "../components/webgl/Reflect.astro";
import Vision from "../components/sections/Vision.astro";
import ServiceSec from "../components/sections/ServiceSec.astro";
import WorksSec from "../components/sections/WorksSec.astro";
import BlogSec from "../components/sections/BlogSec.astro";
import Banner from "../components/ui/Banner.astro";
import MailIcon from "../assets/img/icon/mail.svg";
import CalculateIcon from "../assets/img/icon/calculator.svg";
import FlickerText from "../components/ui/FlickerText.astro";
import Marquee from "../components/ui/Marquee.astro";
import SEO from "../components/common/SEO.astro";

const siteUrl = Astro.site;
const ogpImg = new URL("/img/ogp/ogp.webp", siteUrl).href;

// 構造化データ
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "UCHIWA Creative Studio",
  image: ogpImg,
  email: "info@uchiwa-design.net",
  address: {
    "@type": "PostalAddress",
    addressLocality: "札幌市",
    addressRegion: "北海道",
    addressCountry: "JP",
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    opens: "09:00",
    closes: "18:00",
  },
  priceRange: "￥4,000～￥3,000,000",
  url: "https://www.uchiwa-design.net",
  sameAs: [
    "https://x.com/KoriUchiwa",
    "https://www.facebook.com/WEBdesigner.uchiwa",
    "https://www.instagram.com/uchiwa_cs/?hl=ja",
  ],
  description:
    "札幌を拠点に全国対応するWeb制作スタジオ「UCHIWA Creative Studio」。コンセプト設計からUI/UXデザイン、Three.jsやWebGPUを活用した高度な3D演出・実装まで一貫対応。企業サイト・LP制作やリニューアルのご相談はお気軽にどうぞ。",
};

const jsonLdString = JSON.stringify(jsonLd);
---

<Base pageType="home" bodyClass="home">
  <Fragment slot="head">
    <SEO
      description="札幌を拠点に全国対応するWeb制作スタジオ「UCHIWA Creative Studio」。コンセプト設計からUI/UXデザイン、Three.jsやWebGPUを活用した高度な3D演出・実装まで一貫対応。企業サイト・LP制作やリニューアルのご相談はお気軽にどうぞ。"
      jsonLdString={jsonLdString}
    />
  </Fragment>

  <Kv />
  <ServiceSec />
  <WorksSec />
  <BlogSec />
  <section class="bl_bannerSec">
    <div class="bl_bannerSec_inner hl_contentWidthMiddle">
      <Banner
        link="/price"
        ja="料金表"
        en="price"
        text="作りたいWebサイトの大枠が既に決まっている方は、こちらで概算金額を算出できます。"
        annotaion="あくまでも目安としての金額となりますのでご了承ください。"
      >
        <CalculateIcon slot="icon" />
      </Banner>
      <Banner
        link="/contact"
        ja="お問い合わせ"
        en="contact"
        text="Webサイト立ち上げのご相談、お見積りのご依頼（無料）などお気軽にお問い合わせください。"
      >
        <MailIcon slot="icon" />
      </Banner>
    </div>
  </section>

  <Marquee>
    <p class="bl_marquee_text font-48-80">
      PASSION BECOMES
      <FlickerText text="DESIGN." class="hl_accentColor" />
      DESIGN BECOMES
      <FlickerText text="EMOTION." class="hl_accentColor" />
    </p>
  </Marquee>

  <div class="ly_wrapper"></div>
</Base>

<style lang="scss">
  @use "../styles/utility" as *;
  @use "../styles/global" as *;
  // .ly_wrapper {
  //   padding: 0 2rem;
  //   display: flex;
  //   flex-direction: column;
  //   width: 100%;
  //   gap: 300px;
  //   & > div {
  //     width: 100%;
  //     max-width: 1000px;
  //   }
  // }

  .video {
    width: 300px;
    height: 300px;
  }
  #div {
    width: 300px;
    height: 300px;
  }
  .image {
    width: 100%;
    height: auto;
    aspect-ratio: 2/1;
  }

  .kickman {
    width: 50%;
    aspect-ratio: 1;
    margin-inline: auto;
  }

  .bl_bannerSec_inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(to-rem(300px), 1fr));
    gap: to-rem(40px);
  }

  .bl_marquee_text {
    color: $c-white;
    font-size: fluid-text(32px, 64px);
    font-weight: 700;
    white-space: nowrap;
    line-height: 1;
  }
</style>
