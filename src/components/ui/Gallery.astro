---
const { className = "" } = Astro.props;
---

<div class:list={["bl_gallery", className]}>
  <slot />
</div>

<!-- Lightbox Modal -->
<div class="bl_lightbox" aria-hidden="true">
  <button class="bl_lightbox_close" aria-label="閉じる">&times;</button>
  <button class="bl_lightbox_prev" aria-label="前へ">&#8249;</button>
  <div class="bl_lightbox_content">
    <img class="bl_lightbox_img" src="" alt="" />
    <p class="bl_lightbox_caption"></p>
  </div>
  <button class="bl_lightbox_next" aria-label="次へ">&#8250;</button>
</div>

<script>
  const initLightbox = () => {
    const galleries = document.querySelectorAll(".bl_gallery");

    galleries.forEach((gallery, gIndex) => {
      // Find the associated modal by scanning forward siblings
      let nextEl = gallery.nextElementSibling;
      while (nextEl && !nextEl.classList.contains("bl_lightbox")) {
        nextEl = nextEl.nextElementSibling;
      }
      const modal = nextEl as HTMLElement;
      if (!modal) {
        console.error("[Lightbox] Modal not found for gallery index:", gIndex);
        return;
      }

      // Move modal to document.body to escape GSAP ScrollSmoother's transform container
      document.body.appendChild(modal);

      const lightboxImg = modal.querySelector(
        ".bl_lightbox_img",
      ) as HTMLImageElement;
      const lightboxCaption = modal.querySelector(
        ".bl_lightbox_caption",
      ) as HTMLElement;
      const closeBtn = modal.querySelector(".bl_lightbox_close") as HTMLElement;
      const prevBtn = modal.querySelector(".bl_lightbox_prev") as HTMLElement;
      const nextBtn = modal.querySelector(".bl_lightbox_next") as HTMLElement;

      let currentIndex = -1;

      // Helper to dynamically get images inside this gallery
      const getImages = () => Array.from(gallery.querySelectorAll("img"));

      function openLightbox(index: number, activeImgs: HTMLImageElement[]) {
        currentIndex = index;
        const img = activeImgs[currentIndex];
        if (!img) return;

        lightboxImg.src = img.currentSrc || img.src;
        lightboxImg.alt = img.alt;
        lightboxCaption.textContent = img.alt || `Image ${currentIndex + 1}`;

        modal.classList.add("is_active");
        modal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden"; // Prevent scrolling background
      }

      function changeImage(newIndex: number) {
        if (newIndex === currentIndex) return;
        const activeImgs = getImages();
        const nextImg = activeImgs[newIndex];
        if (!nextImg) return;

        lightboxImg.classList.add("is_switching");

        setTimeout(() => {
          currentIndex = newIndex;
          lightboxImg.src = nextImg.currentSrc || nextImg.src;
          lightboxImg.alt = nextImg.alt;
          lightboxCaption.textContent =
            nextImg.alt || `Image ${currentIndex + 1}`;

          const handleLoad = () => {
            lightboxImg.classList.remove("is_switching");
            lightboxImg.removeEventListener("load", handleLoad);
          };

          if (lightboxImg.complete) {
            lightboxImg.classList.remove("is_switching");
          } else {
            lightboxImg.addEventListener("load", handleLoad);
          }
        }, 150); // 150ms matches the fade-out duration
      }

      function closeLightbox() {
        modal.classList.remove("is_active");
        modal.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
        lightboxImg.classList.remove("is_switching");
      }

      function showNext() {
        const activeImgs = getImages();
        const nextIndex =
          currentIndex < activeImgs.length - 1 ? currentIndex + 1 : 0;
        changeImage(nextIndex);
      }

      function showPrev() {
        const activeImgs = getImages();
        const prevIndex =
          currentIndex > 0 ? currentIndex - 1 : activeImgs.length - 1;
        changeImage(prevIndex);
      }

      // Event delegation for clicks on gallery images
      gallery.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        const img = target.closest("img");
        if (!img) return;

        const activeImgs = getImages();
        const index = activeImgs.indexOf(img);
        if (index !== -1) {
          openLightbox(index, activeImgs);
        }
      });

      closeBtn.addEventListener("click", closeLightbox);
      prevBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        showPrev();
      });
      nextBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        showNext();
      });

      // Close when clicking outside the content
      modal.addEventListener("click", (e) => {
        if (
          e.target === modal ||
          e.target === modal.querySelector(".bl_lightbox_content")
        ) {
          closeLightbox();
        }
      });

      // Keyboard navigation
      document.addEventListener("keydown", (e) => {
        if (!modal.classList.contains("is_active")) return;
        if (e.key === "Escape") closeLightbox();
        if (e.key === "ArrowRight") showNext();
        if (e.key === "ArrowLeft") showPrev();
      });
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initLightbox);
  } else {
    initLightbox();
  }
</script>

<style lang="scss">
  @use "../../styles/utility" as *;
  @use "../../styles/global" as *;

  .bl_gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(to-rem(200px), 1fr));
    gap: to-rem(24px) to-rem(12px);
    padding: to-rem(40px) 0;

    :global(picture),
    :global(img) {
      cursor: pointer;
      overflow: hidden;
      border-radius: to-rem(8px);
      transition:
        transform 0.4s cubic-bezier(0.25, 1, 0.5, 1),
        filter 0.3s ease,
        box-shadow 0.3s ease;

      &:hover {
        transform: scale(1.03) translateY(-4px);
        filter: brightness(1.1);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
      }
    }
  }

  /* Lightbox Styles */
  .bl_lightbox {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(17, 0, 40, 0.85); // Theme matches --c-bg (#110028)
    backdrop-filter: blur(12px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s cubic-bezier(0.25, 1, 0.5, 1);

    &.is_active {
      opacity: 1;
      pointer-events: auto;
    }
  }

  .bl_lightbox_content {
    max-width: 90%;
    max-height: 80%;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform: scale(0.9);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);

    .is_active & {
      transform: scale(1);
    }
  }

  .bl_lightbox_img {
    max-width: 100%;
    max-height: 75vh;
    object-fit: contain;
    border-radius: to-rem(8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
    transition:
      opacity 0.25s cubic-bezier(0.25, 1, 0.5, 1),
      transform 0.25s cubic-bezier(0.25, 1, 0.5, 1);
    opacity: 1;
    transform: scale(1);

    &.is_switching {
      opacity: 0;
      transform: scale(0.97);
    }
  }

  .bl_lightbox_caption {
    margin-top: to-rem(16px);
    color: var(--c-text);
    font-size: to-rem(16px);
    font-weight: 500;
    text-align: center;
  }

  .bl_lightbox_close,
  .bl_lightbox_prev,
  .bl_lightbox_next {
    position: absolute;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--c-white);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    backdrop-filter: blur(4px);
    z-index: 10000;
    user-select: none;

    &:hover {
      background: var(--c-orange);
      border-color: var(--c-orange);
      transform: scale(1.1);
    }

    &:active {
      transform: scale(0.95);
    }
  }

  .bl_lightbox_close {
    top: to-rem(24px);
    right: to-rem(24px);
    width: to-rem(48px);
    height: to-rem(48px);
    font-size: to-rem(28px);
    line-height: 1;
  }

  .bl_lightbox_prev {
    left: to-rem(24px);
    width: to-rem(56px);
    height: to-rem(56px);
    font-size: to-rem(32px);

    @include mq("md") {
      left: to-rem(8px);
      width: to-rem(44px);
      height: to-rem(44px);
      font-size: to-rem(24px);
    }
  }

  .bl_lightbox_next {
    right: to-rem(24px);
    width: to-rem(56px);
    height: to-rem(56px);
    font-size: to-rem(32px);

    @include mq("md") {
      right: to-rem(8px);
      width: to-rem(44px);
      height: to-rem(44px);
      font-size: to-rem(24px);
    }
  }
</style>
