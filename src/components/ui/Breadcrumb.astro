---
/**
 * Breadcrumb コンポーネント
 *
 * URL パスを元にパンくずリストを自動生成します。
 *
 * Props:
 *   currentLabel?: string
 *     現在ページのラベルを上書きしたい場合に指定。
 *     省略すると routeMap から自動取得します。
 *
 *   items?: { label: string; href?: string }[]
 *     パンくずアイテムを完全に手動で指定したい場合に使用。
 *     指定した場合、自動生成をスキップします。
 *     最後のアイテムが自動的に「現在ページ」として扱われます。
 */

interface BreadcrumbItem {
  label: string;
  href?: string;
  isCurrent: boolean;
}

interface Props {
  currentLabel?: string;
  items?: { label: string; href?: string }[];
}

const { currentLabel, items: manualItems } = Astro.props;

// ルートとラベルのマッピング（ページを追加したらここに追記）
const routeMap: Record<string, string> = {
  about: "UCHIWAについて",
  service: "事業内容",
  diverse: "DIVERSE",
};

let breadcrumbItems: BreadcrumbItem[] = [];

if (manualItems && manualItems.length > 0) {
  // 手動指定モード
  breadcrumbItems = manualItems.map((item, index) => ({
    ...item,
    isCurrent: index === manualItems.length - 1,
  }));
} else {
  // URL パスから自動生成
  const pathname = Astro.url.pathname;
  const segments = pathname.split("/").filter(Boolean);

  // ホームは常に先頭
  breadcrumbItems = [
    {
      label: "ホーム",
      href: "/",
      isCurrent: segments.length === 0,
    },
  ];

  let cumulativePath = "";
  segments.forEach((segment, index) => {
    cumulativePath += `/${segment}`;
    const isCurrent = index === segments.length - 1;
    const label =
      isCurrent && currentLabel ? currentLabel : (routeMap[segment] ?? segment);

    breadcrumbItems.push({
      label,
      href: isCurrent ? undefined : cumulativePath,
      isCurrent,
    });
  });
}
---

<nav aria-label="パンくずリスト">
  <ul class="bl_breadcrumb">
    {
      breadcrumbItems.map((item, index) => (
        <>
          {index > 0 && (
            <li class="bl_breadcrumb_sep" aria-hidden="true">
              <hr />
            </li>
          )}
          <li
            class:list={[
              "bl_breadcrumb_item",
              item.isCurrent && "bl_breadcrumb_item--current",
            ]}
          >
            {item.isCurrent ? (
              <span aria-current="page" class="font-12-16">
                {item.label}
              </span>
            ) : (
              <a href={item.href} class="font-12-16">
                {item.label}
              </a>
            )}
          </li>
        </>
      ))
    }
  </ul>
</nav>

<style lang="scss">
  @use "../../styles/utility" as *;
  @use "../../styles/global" as *;

  .bl_breadcrumb {
    width: 100%;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin: 0;

    &_item {
      display: flex;
      align-items: center;
      padding: to-rem(3px) to-rem(18px);
      border-radius: 4px;
      border: solid 1px $c-white;

      & > * {
        display: block;
        width: 100%;
        height: 100%;
        text-align: center;
      }

      & > a {
        color: $c-white;
        transition: opacity 0.2s ease;
        &:hover {
          opacity: 0.6;
        }
      }

      &--current {
        color: #8b8b8b;
        border: solid 1px #8b8b8b;
      }
    }

    &_sep {
      display: flex;
      align-items: center;
      font-size: to-rem(12px);
      opacity: 0.6;
      user-select: none;
      hr {
        width: 1.5rem;
      }
    }
  }
</style>
