---
interface BreadcrumbItem {
  label: string;
  href?: string;
  isCurrent: boolean;
}

interface Props {
  currentLabel?: string;
  items?: { label: string; href?: string }[];
}

const { currentLabel, items: manualItems } = Astro.props;

const routeMap: Record<string, string> = {
  about: "UCHIWAについて",
  service: "事業内容",
  diverse: "DIVERSE",
  price: "料金表",
  works: "制作物",
};

let breadcrumbItems: BreadcrumbItem[] = [];

//呼び出し元で配列で手動指定された場合
if (manualItems && manualItems.length > 0) {
  breadcrumbItems = manualItems.map((item, index) => ({
    ...item, // itemのすべてのプロパティをコピー
    isCurrent: index === manualItems.length - 1, // 配列の最後の要素をisCurrentにする
  }));
} else {
  //呼び出し元で配列で手動指定されなかった場合

  // urlからパスを抽出
  const pathname = Astro.url.pathname;
  //splitを使ってパスを配列に変換
  const segments = pathname.split("/").filter(Boolean);
  // 調整用配列を定義(categoryを除く & pageを除く)
  const normalizedSegments: string[] = [];

  // パスの長さだけループ処理を行う
  for (let index = 0; index < segments.length; index += 1) {
    // 配列のindex番目のパスを取得
    const segment = segments[index];
    // "category"の場合はスキップ
    if (segment === "category") continue;
    // "page"の場合は次のindexをスキップ
    if (segment === "page" && /^\d+$/.test(segments[index + 1] ?? "")) {
      index += 1;
      continue;
    }

    // 調整用配列に追加
    normalizedSegments.push(segment);
  }

  breadcrumbItems = [
    {
      label: "ホーム",
      href: "/",
      isCurrent: normalizedSegments.length === 0,
    },
  ];

  let cumulativePath = "";

  // 調整用配列をループ処理
  normalizedSegments.forEach((segment, index) => {
    // 累積パスに追加
    cumulativePath += `/${segment}`;
    // 現在のパスかどうかのフラグ
    const isCurrent = index === normalizedSegments.length - 1;

    const label =
      // 現在のパスフラグがtrueの場合、currentLabelを参照し、currentLabelが設定されていればそれを表示、
      // currentLabelが設定されていなければrouteMapからsegmentを参照し、存在しなければsegmentを表示
      isCurrent && currentLabel ? currentLabel : (routeMap[segment] ?? segment);

    breadcrumbItems.push({
      label,
      href: isCurrent ? undefined : cumulativePath,
      isCurrent,
    });
  });
}
---

<nav aria-label="パンくずリスト">
  <ul class="bl_breadcrumb">
    {
      breadcrumbItems.map((item, index) => (
        <>
          {index > 0 && (
            <li class="bl_breadcrumb_sep" aria-hidden="true">
              <hr />
            </li>
          )}
          <li
            class:list={[
              "bl_breadcrumb_item",
              item.isCurrent && "bl_breadcrumb_item--current",
            ]}
          >
            {item.isCurrent ? (
              <span aria-current="page" class="font-12-16">
                {item.label}
              </span>
            ) : (
              <a href={item.href} class="font-12-16">
                {item.label}
              </a>
            )}
          </li>
        </>
      ))
    }
  </ul>
</nav>

<style lang="scss">
  @use "../../styles/utility" as *;
  @use "../../styles/global" as *;

  .bl_breadcrumb {
    width: 100%;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin: 0;

    &_item {
      display: flex;
      align-items: center;
      padding: to-rem(3px) to-rem(18px);
      border-radius: 4px;
      border: solid 1px $c-white;

      & > * {
        display: block;
        width: 100%;
        height: 100%;
        text-align: center;
      }

      & > a {
        color: $c-white;
        transition: opacity 0.2s ease;
        &:hover {
          opacity: 0.6;
        }
      }

      &--current {
        color: #8b8b8b;
        border: solid 1px #8b8b8b;
      }
    }

    &_sep {
      display: flex;
      align-items: center;
      font-size: to-rem(12px);
      opacity: 0.6;
      user-select: none;
      hr {
        width: 1.5rem;
      }
    }
  }
</style>
