---
interface BreadcrumbItem {
  label: string;
  href?: string;
  isCurrent: boolean;
}

interface Props {
  currentLabel?: string;
  items?: { label: string; href?: string }[];
}

const { currentLabel, items: manualItems } = Astro.props;

const routeMap: Record<string, string> = {
  about: "UCHIWAについて",
  service: "事業内容",
  diverse: "DIVERSE",
  price: "料金表",
  works: "制作物",
  "web-tips": "ブログ",
  contact: "お問い合わせ",
};

let breadcrumbItems: BreadcrumbItem[] = [];

// 手動設定がある場合は手動設定を優先
if (manualItems && manualItems.length > 0) {
  // 手動設定されたパンくずリストを生成
  breadcrumbItems = manualItems.map((item, index) => ({
    ...item,
    isCurrent: index === manualItems.length - 1,
  }));
} else {
  // パスを取得
  const pathname = Astro.url.pathname;
  // パスをスラッシュで分割し、空の要素を除外
  const segments = pathname.split("/").filter(Boolean);
  // pageと数字の組み合わせを除外
  const normalizedSegments: string[] = [];

  //パスの長さ分だけループ
  for (let index = 0; index < segments.length; index += 1) {
    // パスのセグメントを取得
    const segment = segments[index];
    if (segment === "category" || segment === "class") continue;
    if (segment === "page" && /^\d+$/.test(segments[index + 1] ?? "")) {
      index += 1;
      continue;
    }

    normalizedSegments.push(segment);
  }

  breadcrumbItems = [
    {
      label: "ホーム",
      href: "/",
      isCurrent: normalizedSegments.length === 0,
    },
  ];

  let cumulativePath = "";

  normalizedSegments.forEach((segment, index) => {
    cumulativePath += `/${segment}`;
    const isCurrent = index === normalizedSegments.length - 1;
    const label =
      isCurrent && currentLabel ? currentLabel : (routeMap[segment] ?? segment);

    breadcrumbItems.push({
      label,
      href: isCurrent ? undefined : `${cumulativePath}/`,
      isCurrent,
    });
  });
}
---

<nav aria-label="パンくずリスト">
  <ul class="bl_breadcrumb">
    {
      breadcrumbItems.map((item, index) => (
        <>
          {index > 0 && (
            <li class="bl_breadcrumb_sep" aria-hidden="true">
              <hr />
            </li>
          )}
          <li
            class:list={[
              "bl_breadcrumb_item",
              item.isCurrent && "bl_breadcrumb_item--current",
            ]}
            data-mouse="stuck"
            data-mouse-shape="element"
          >
            {item.isCurrent ? (
              <span aria-current="page" class="font-12-16">
                {item.label}
              </span>
            ) : (
              <a href={item.href} class="font-12-16">
                {item.label}
              </a>
            )}
          </li>
        </>
      ))
    }
  </ul>
</nav>

<style lang="scss">
  @use "../../styles/utility" as *;
  @use "../../styles/global" as *;

  .bl_breadcrumb {
    width: 100%;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin: 0;

    &_item {
      display: flex;
      align-items: center;
      padding: to-rem(3px) to-rem(18px);
      border-radius: 4px;
      border: solid 1px $c-white;
      max-width: 15em;

      & > * {
        display: block;
        width: 100%;
        height: 100%;
        text-align: center;

        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      & > a {
        color: $c-white;
        transition: opacity 0.2s ease;
        &:hover {
          opacity: 0.6;
        }
      }

      &--current {
        color: #8b8b8b;
        border: solid 1px #8b8b8b;
      }
    }

    &_sep {
      display: flex;
      align-items: center;
      font-size: to-rem(12px);
      opacity: 0.6;
      user-select: none;
      hr {
        width: 1.5rem;
      }
    }
  }
</style>
