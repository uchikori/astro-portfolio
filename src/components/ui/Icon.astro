---
const { icon } = Astro.props;

import web from "../../assets/img/icon/web.svg?raw";
import lightning from "../../assets/img/icon/lightning-bolt.svg?raw";
import cart from "../../assets/img/icon/cart.svg?raw";
import config from "../../assets/img/icon/config.svg?raw";
import chat from "../../assets/img/icon/chat.svg?raw";
import compass from "../../assets/img/icon/compass.svg?raw";
import document from "../../assets/img/icon/document.svg?raw";
import design from "../../assets/img/icon/design.svg?raw";
import code from "../../assets/img/icon/code.svg?raw";
import rocket from "../../assets/img/icon/rocket.svg?raw";
import handshake from "../../assets/img/icon/handshake.svg?raw";
import filter from "../../assets/img/icon/filter.svg?raw";

// 各アイコンをマッピング
const icons = {
  web,
  lightning,
  cart,
  config,
  chat,
  compass,
  document,
  design,
  code,
  rocket,
  handshake,
  filter,
};

const currentIconHtml = icons[icon];
---

<figure class="el_icon">
  {currentIconHtml && <Fragment set:html={currentIconHtml} />}
</figure>

<style lang="scss">
  @use "../../styles/utility" as *;
  @use "../../styles/global" as *;
  .el_icon {
    aspect-ratio: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    :global(.bl_serviceItem) & {
      width: 3.5rem;
      background: #d9d9d9;
      border-radius: to-rem(12px);
    }
    :global(.bl_flowItem) & {
      width: 6.25rem;
      background: #ab5cff;
      border-radius: 100vh;
      border: solid 1px var(--c-text);
      @include mq("md") {
        width: 3rem;
      }
    }
  }

  /* SVG styles using top-level :global to avoid scoping and compilation issues */

  :global(.bl_serviceItem) .el_icon :global(svg) {
    width: 2rem;
    height: auto;
  }

  :global(.bl_flowItem) .el_icon :global(svg) {
    width: 4rem;
    height: auto;
    @include mq("md") {
      width: 2rem;
    }
  }

  .el_icon :global(svg *) {
    transition:
      stroke 0.3s,
      fill 0.3s;
  }

  .el_icon :global(svg *[stroke]) {
    stroke: currentColor;
  }

  .el_icon :global(svg *[fill]) {
    fill: currentColor;
  }
</style>
