---
const { title, tag: Tag = "h2", class: className = "" } = Astro.props;
---

{
  title ? (
    <Tag
      class:list={["bl_section_title font-24-32", className]}
      set:html={title}
    />
  ) : (
    <Tag class:list={["bl_section_title font-24-32", className]}>
      <slot name="title" />
    </Tag>
  )
}

<style lang="scss">
  @use "../../styles/utility" as *;
  @use "../../styles/global" as *;

  .bl_section_title {
    font-weight: 500;
  }
</style>
