---
const { tag: Tag = "h3", content } = Astro.props;
---

<li class="bl_cardWithNumber bl_cardList_item">
  <hr />
  <Tag class="bl_cardWithNumber_title font-16-20">{content}</Tag>
</li>

<style lang="scss">
  @use "../../styles/utility" as *;
  @use "../../styles/global" as *;
  .bl_cardWithNumber {
    /*   */
    counter-increment: number;
    padding: to-rem(24px) to-rem(16px);
    color: var(--c-text);
    border-radius: 6px;
    // background: rgba(255, 255, 255, 0.15);
    background:
      url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E"),
      rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(10px);
    position: relative;
    z-index: 1000;
    &::before {
      content: "0" counter(number) " ";
      font-size: fluid-text(24px, 56px);
      font-family: $accent-font;
      color: var(--c-text);
      line-height: 1;
      // display: inline-block;
      // width: 1em;
      // height: 1em;
      text-align: center;
    }
    hr {
      width: 2rem;
      margin-top: 1rem;
      border-color: var(--c-orange);
    }
    &_title {
      margin-top: 1.5rem;
      font-weight: 500;
      line-height: 2;
    }
  }
</style>
