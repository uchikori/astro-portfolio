---
const {
  href = "/",
  text = "View More",
  class: className = "",
  fontSize = "",
  svgWidth = "",
} = Astro.props;
const uniqueId = `clip_${Math.floor(Math.random() * 100000000)}`;
---

<a href={href} class:list={["el_link hl_accentFont", className]}>
  <span class="el_link_text" style={`font-size:${fontSize}`}>{text}</span>
  <svg
    width="72"
    height="72"
    viewBox="0 0 72 72"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="el_link_icon"
    data-mouse="stuck"
    style={`width:${svgWidth}`}
  >
    <rect
      x="0.5"
      y="0.5"
      width="71"
      height="71"
      rx="35.5"
      stroke="var(--c-text)"></rect>
    <g clip-path={`url(#${uniqueId})`}>
      <path
        d="M39.0149 42L39 41.9809L43.641 36.0003L39 30.0191L39.0149 30H41.3419L46 35.9997L41.3419 41.9989L39.0149 42Z"
        fill="var(--c-text)"></path>
      <path d="M26 35H45V37H26V35Z" fill="var(--c-text)"></path>
    </g>
    <defs>
      <clipPath id={uniqueId}>
        <rect
          width="12"
          height="20"
          fill="var(--c-text)"
          transform="matrix(0 1 -1 0 46 30)"></rect>
      </clipPath>
    </defs>
  </svg>
</a>

<style lang="scss">
  @use "../../styles/utility" as *;
  @use "../../styles/global" as *;

  .el_link {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: to-em(40px);
    color: var(--c-text);
    transition: all 0.3s ease;
    position: relative;
    &_text {
      font-size: to-rem(32px);
    }

    svg {
      width: fluid-text(54px, 72px);
      height: auto;
    }

    @media (hover: hover) {
      &:hover {
        color: var(--c-orange);
        transition: all 0.3s ease;
        g {
          transition: transform 0.5s ease;
          transform: translateX(4px);
        }
      }
    }
  }
</style>
