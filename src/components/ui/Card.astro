---
const { title, category, thumbnail, date } = Astro.props;
import { Picture } from "astro:assets";
import FolderIcon from "../../assets/img/icon/material-symbols_folder.svg";
import TimeIcon from "../../assets/img/icon/mingcute_time-fill.svg";
---

<div class="bl_card" data-mouse="highlight" data-mouse-scale="3">
  <figure class="bl_card_thumbnail">
    <Picture
      src={thumbnail}
      formats={["avif", "webp"]}
      widths={[375, 710, 1420]}
      sizes="(max-width: 768px) 100vw, 1420px"
      alt="サンプル画像"
      width={710}
      height={335}
      loading="lazy"
    />
  </figure>
  <div class="bl_card_meta">
    <span class="bl_card_category"><FolderIcon />{category}</span>
    <time class="bl_card_date" datetime={date}><TimeIcon />{date}</time>
  </div>
  <h3 class="bl_card_title">{title}</h3>
</div>

<style lang="scss">
  @use "../../styles/utility" as *;
  @use "../../styles/global" as *;

  .bl_card {
    width: 100%;
    height: 100%;
    min-height: to-rem(360px);
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: to-rem(24px) to-rem(24px) to-rem(40px) to-rem(24px);
    display: flex;
    flex-direction: column;
    gap: to-rem(16px);
    border-radius: 8px;
    transition: transform 0.3s ease, background 0.3s ease;
    @media (hover: hover) {
      &:hover {
        transform: scale(1.03);
        background: rgba(255, 255, 255, 0.25);
      }
    }
    &_thumbnail {
      width: 100%;
      aspect-ratio: 312/175;
      overflow: hidden;
    }
    &_meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    &_category {
      padding: to-rem(4px);
      color: $c-white;
      background-color: $c-orange;
      border-radius: to-rem(4px);
      display: flex;
      gap: to-rem(4px);
      align-items: center;
      font-size: to-rem(14px);
      line-height: 1;
      svg {
        width: 12px;
        height: 12px;
      }
    }
    &_date {
      display: flex;
      gap: to-rem(4px);
      align-items: center;
      font-size: to-rem(14px);
      color: white;
      line-height: 1;
    }
    &_title {
      font-size: to-rem(18px);
      font-weight: 500;
      color: white;
    }
  }
</style>
