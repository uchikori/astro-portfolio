---
//alignの初期値を'right'に設定
const { align = "right" } = Astro.props;
---

<div class:list={["bl_nav", { "is-left": align === "left" }]}>
  <button class="el_navBtn el_navBtn__prev js_navBtn__prev" data-mouse="stuck">
    <img src="/img/view_more.svg" alt="前へ" />
  </button>
  <button class="el_navBtn el_navBtn__next js_navBtn__next" data-mouse="stuck">
    <img src="/img/view_more.svg" alt="次へ" />
  </button>
</div>

<style lang="scss">
  @use "../../styles/utility" as *;
  @use "../../styles/global" as *;
  .bl_nav {
    font-size: fluid-text(54px, 72px);
    display: flex;
    gap: fluid-text(24px, 40px);
    &.is-left {
      text-align: left;
    }
  }

  .el_navBtn {
    width: fluid-text(54px, 72px);
    aspect-ratio: 1;
    background-color: transparent;
    border: none;
    opacity: 0.7;
    cursor: pointer;
    padding: 0;

    &:active {
      transform: scale(0.85);
    }

    &__prev {
      img {
        transform: rotate(180deg);
      }
    }
  }
</style>
