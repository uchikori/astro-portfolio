---
import Fv from "./Fv.astro";
import FlickerText from "./FlickerText.astro";
import Sns from "./Sns.astro";
---

<div class="bl_hero js_hero">
  <div class="bl_hero_kv">
    <video
      id="js-kv-video"
      class="bl_hero_video kv-img"
      autoplay
      muted
      loop
      playsinline
    >
      <source
        media="(max-width: 959px)"
        src="/movie/kv_mobile_converted.mp4"
        type="video/mp4"
      />
      <source src="/movie/kv_converted.mp4" type="video/mp4" />
    </video>
  </div>

  <div class="bl_hero_cover">
    <div class="bl_hero_inner hl_contentWidth">
      <div class="bl_hero_content">
        <h2 class="bl_hero_title">
          PASSION BECOMES<br />
          <FlickerText text="DESIGN." class="hl_accentColor" />
          <br />DESIGN BECOMES<br />
          <FlickerText text="EMOTION." class="hl_accentColor" />
        </h2>
        <Sns alignItems="flex-start" className="hl_smHidden" />
        <div
          class="bl_hero_object"
          data-webgl="normal"
          data-model="/model/logo.glb"
          data-render-material="standard"
          data-roughness="0.3"
          data-metalness="0.5"
          data-rotation-x="0"
          data-rotation-y="45"
          data-rotation-z="5"
        >
        </div>
        <p class="bl_hero_text">
          好きという気持ちを原動力に、<br
          />誰かの心を動かすデザインをつくっています。
        </p>
      </div>
      <div class="bl_hero_sub">
        <div class="bl_hero_sub_grid">
          <div class="bl_hero_sub_gridItem grid_1">
            <img
              data-webgl="template"
              data-tex-1="/img/grid/grid_1.webp"
              data-mesh-position-z="1"
              alt=""
            />
          </div>
          <div class="bl_hero_sub_gridItem grid_2">
            <img
              data-webgl="template"
              data-tex-1="/img/grid/grid_2.webp"
              alt=""
            />
          </div>
          <div class="bl_hero_sub_gridItem bl_hero_sub_content grid_3">
            <hgroup class="bl_hero_sub_title bl_sectiontitle">
              <h2 class="font-48-80 hl_uppercase">
                <span class="hl_accentColor">a</span>bout
              </h2>
              <span class="bl_sectiontitle_en font-16-20">UCHIWAについて</span>
            </hgroup>
            <p class="bl_hero_sub_text font-16-20">
              北海道札幌市の個人事業のWebデザイナー。<br />
              「UCHIWA Creative Studio」という屋号で道内・道外問わず、<br />
              全国のお客様のWebサイト作りに携わらせて頂いております。
            </p>
            <a href="" class="bl_hero_sub_link el_link" data-mouse="stuck">
              <span class="el_link_text">View More</span>
              <svg
                width="72"
                height="72"
                viewBox="0 0 72 72"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                class="el_link_icon"
              >
                <rect
                  x="0.5"
                  y="0.5"
                  width="71"
                  height="71"
                  rx="35.5"
                  stroke="white"></rect>
                <g clip-path="url(#clip0_826_1656)">
                  <path
                    d="M39.0149 42L39 41.9809L43.641 36.0003L39 30.0191L39.0149 30H41.3419L46 35.9997L41.3419 41.9989L39.0149 42Z"
                    fill="white"></path>
                  <path d="M26 35H45V37H26V35Z" fill="white"></path>
                </g>
                <defs>
                  <clipPath id="clip0_826_1656">
                    <rect
                      width="12"
                      height="20"
                      fill="white"
                      transform="matrix(0 1 -1 0 46 30)"></rect>
                  </clipPath>
                </defs>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  //
  const video = document.getElementById("js-kv-video");
  const mq = window.matchMedia("(max-width: 959px)");

  function updateVideoSrc(e) {
    const newSrc = e.matches
      ? "/movie/kv_mobile_converted.mp4"
      : "/movie/kv_converted.mp4";

    if (video.currentSrc !== location.origin + newSrc) {
      video.src = newSrc;
      video.load();
      video.play();
    }
  }

  if (video && mq) {
    mq.addEventListener("change", updateVideoSrc);
  }
</script>

<style lang="scss">
  @use "../styles/utility" as *;
  @use "../styles/global" as *;

  .bl_hero {
    position: relative;
    &_kv {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100svh;
    }

    @keyframes floating {
      0%,
      100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-15px);
      }
    }

    &_cover {
      width: 100%;
    }
    &_inner {
    }
    &_content {
      width: 100%;
      height: 100svh;
      padding: fluid-text(100px, 140px) 0;
      color: #fff;
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      grid-template-rows: repeat(12, 1fr);
      gap: 0 40px;
      position: relative;

      @include mq(lg) {
        display: flex;
        flex-direction: column;
      }
    }
    &_title {
      grid-column: 1 / 7; /* 1列目から5列目まで */
      grid-row: 3 / 7; /* 2行目から9行目まで */
      font-size: fluid-text(30px, 56px, 375px, 1920px);
      white-space: nowrap;

      @include mq(lg) {
        order: 2;
      }
    }
    &_object {
      grid-column: 5/9;
      grid-row: 5/9;
      width: 700px;
      aspect-ratio: 1;
      align-self: center; // グリッドセル内で上下中央に配置
      justify-self: center;
      animation: floating 2s ease-in-out infinite; // 4秒周期でふわふわさせる
      @include mq(lg) {
        width: 50%;
        order: 1;
      }
      @include mq(md) {
        width: calc(300 / 390) * 100%;
      }
    }
    &_text {
      grid-column: 8 / -1;
      grid-row: 11 / -1;
      align-self: end;
      justify-self: end;
      font-size: fluid-text(16px, 24px, 375px, 1920px);
      @include mq(lg) {
        order: 3;
        margin-top: to-rem(24px);
        align-self: start;
      }
    }
    ::global(.bl_sns) {
      grid-column: 1/3;
      grid-row: 11/-1;
      align-self: end;
    }

    &_sub {
      width: 100%;
      padding: fluid-text(120px, 160px) 0 to-rem(120px) 0;
      &_grid {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        grid-template-rows: repeat(12, 70px);
        gap: 32px 40px;
        .grid_1 {
          grid-column: 1/5;
          grid-row: 2/11;
          aspect-ratio: 560/784;
          z-index: 2;
          &:after {
            content: "UCHIWA";
            font-size: fluid-text(60px, 120px);
            color: var(--c-white);
            mix-blend-mode: soft-light;
            position: absolute;
            right: 0;
            top: 100%;
            transform: translate(25%, -40%);
            font-weight: 900;
            opacity: 0.7;
          }
        }
        .grid_2 {
          grid-column: 3/10;
          grid-row: 1/8;
          z-index: 1;
        }
        .grid_3 {
          grid-column: 7/-1;
          grid-row: 7/-1;
          // align-self: end;
          z-index: 3;
        }
      }
      &_gridItem {
        position: relative;
        object-fit: cover;
        img {
          width: 100%;
        }
      }
      &_content {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: fluid-text(48px, 64px);
      }
      &_text {
        line-height: 2;
      }
    }
  }

  .bl_sectiontitle {
    h2 {
      letter-spacing: 0.15em;
    }
    & > span {
      display: flex;
      align-items: center;
      gap: 16px;
      &:before {
        content: "";
        display: block;
        width: fluid-text(40px, 72px);
        height: 2px;
        background-color: var(--c-white);
      }
    }
  }

  .el_link {
    display: flex;
    align-items: center;
    gap: 40px;
    color: var(--c-white);
    span {
      font-size: to-rem(32px);
    }
    &:hover {
      color: var(--c-orange);
      transition: color 0.5s ease;
      g {
        transition: transform 0.5s ease;
        transform: translateX(4px);
      }
    }
  }

  #js-kv-video {
    position: relative;
    top: 0;
    left: 0;
    width: 100%;
    height: 100svh;
    // aspect-ratio: 16/9;
    object-fit: cover;
    z-index: -2;
    pointer-events: none;

    @include mq(lg) {
      height: 100svh;
    }
  }
</style>
