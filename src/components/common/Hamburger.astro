<button
  class="bl_hamburger hl_smVisible js_hamburger"
  data-mouse="stuck"
  aria-label="メニューを開く"
>
  <span class="bl_hamburger_inner">
    <span class="bl_hamburger_wrap js_hamburger_wrap">
      <span class="bl_hamburger_bar js_hamburger_bar"></span>
    </span>
    <span class="bl_hamburger_wrap js_hamburger_wrap">
      <span class="bl_hamburger_bar js_hamburger_bar"></span>
    </span>
    <span class="bl_hamburger_wrap js_hamburger_wrap">
      <span class="bl_hamburger_bar js_hamburger_bar"></span>
    </span>
  </span>
</button>

<style lang="scss">
  .bl_hamburger {
    position: relative;
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3em;
    aspect-ratio: 1;
    border: 0;
    border-radius: 100vh;
    background: var(--c-white);
    cursor: pointer;
    pointer-events: auto;
    padding: 0;
    ::global(.ly_header) & {
      mix-blend-mode: difference;
    }
    &_inner {
      position: relative;
      display: block;
      width: 2em;
      height: 1px;
    }
    &_wrap {
      position: absolute;
      left: 0;
      width: 100%;
      &:first-child {
        transform: translateY(-0.5em);
      }
      &:last-child {
        transform: translateY(0.5em);
      }
    }
    &_bar {
      display: block;
      width: 100%;
      height: 1px;
      background-color: var(--c-dark);
    }
  }
</style>
