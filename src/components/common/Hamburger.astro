<button
  class="bl_hamburger hl_smVisible js_hamburger"
  data-mouse="stuck"
  aria-label="メニュー"
>
  <span class="bl_hamburger_inner">
    <span class="bl_hamburger_wrap js_hamburger_wrap">
      <span class="bl_hamburger_bar js_hamburger_bar"></span>
    </span>
    <span class="bl_hamburger_wrap js_hamburger_wrap">
      <span class="bl_hamburger_bar js_hamburger_bar"></span>
    </span>
    <span class="bl_hamburger_wrap js_hamburger_wrap">
      <span class="bl_hamburger_bar js_hamburger_bar"></span>
    </span>
  </span>
</button>

<style lang="scss">
  .bl_hamburger {
    position: relative;
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    aspect-ratio: 1;
    border: 0;
    border-radius: 100vh;
    background: var(--c-text);
    cursor: pointer;
    pointer-events: auto;
    padding: 0;
    transform-origin: right;
    transition: transform 0.2s ease-in-out;

    :global(.inview) & {
      transform: scale(0.95);
      transition: transform 0.2s ease-in-out;
    }

    :global(.ly_header) & {
      mix-blend-mode: difference;
    }

    &_inner {
      position: relative;
      display: block;
      width: 32px;
      height: 1px;
    }
    &_wrap {
      position: absolute;
      left: 0;
      width: 100%;
      &:first-child {
        transform: translateY(-8px);
      }
      &:last-child {
        transform: translateY(8px);
      }
    }
    &_bar {
      display: block;
      width: 100%;
      height: 1px;
      background-color: var(--c-bg);
    }
  }
</style>
