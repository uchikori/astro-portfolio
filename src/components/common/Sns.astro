      </a>
    </li>
  </ul>
</div>

<style lang="scss">
  @use "../../styles/utility" as *;
  @use "../../styles/global" as *;

  .bl_sns {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: to-rem(12px);
    // align-items: flex-end;

    &_title {
      font-size: to-rem(12px);
      letter-spacing: 0.15em;
      line-height: 1;
    }

    &_list {
      display: flex;
      align-items: center;
      gap: 24px;
    }
    &_item {
      padding: to-rem(8px);
    }
    &_link {
      display: block;
      width: to-rem(24px);
      transition:
        transform 0.3s ease,
        opacity 0.3s ease;

      img {
        width: 100%;
        height: auto;
      }
    }
  }
</style>
