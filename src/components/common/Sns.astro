    </li>
    <li class="bl_sns_item" data-mouse="stuck">
      <a
        href="/"
        class="bl_sns_link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Facebook"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          role="img"
          aria-labelledby="title-facebook"
        >
          <title id="title-facebook">Facebook</title>
