---
import { Image } from "astro:assets";

const { alignItems, className, loading = "lazy" } = Astro.props;
---

<div class:list={["bl_sns", className]} style={`align-items: ${alignItems};`}>
  <p class="bl_sns_title">FOLLOW ME</p>
  <ul class="bl_sns_list">
    <li class="bl_sns_item" data-mouse="stuck">
      <a
        href="/"
        class="bl_sns_link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="X (旧Twitter)"
      >
        <svg
          width="24"
          height="25"
          viewBox="0 0 24 25"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          role="img"
          aria-labelledby="title-x"
        >
          <title id="title-x">X (旧Twitter)</title>
