---
import Nav from "./Nav.astro";
---

<div class="bl_menu" style="mix-blend-mode: difference;">
  <div class="bl_menu_inner font-28-32">
    <Nav />
  </div>
</div>

<style lang="scss">
  @use "../../styles/global" as *;
  .bl_menu {
    position: fixed;
    z-index: 100;
    top: 0;
    left: 0;
    width: 100%;
    height: 100svh;
    background-color: var(--c-text);
    overflow: hidden;
    display: flex;
    align-items: center;
    pointer-events: none;

    clip-path: circle(0px at calc(100% - 2.5em) 2.5em);
    transition:
      clip-path 0.4s ease 0.4s,
      pointer-events 0s 0.8s;

    &_inner {
      font-weight: 700;
      width: 100%;
      max-width: 90%;
      margin-inline: auto;
      display: flex;
      justify-content: center;
    }

    &_nav {
      // width: 100%;
    }

    :global(.js_menu_open) & {
      pointer-events: auto;
      clip-path: circle(140% at calc(100% - 2.5em) 2.5em);
      transition: clip-path 0.4s cubic-bezier(1, 0, 1, 0) 0.1s;

      // &_li {
      //   opacity: 1;
      //   transform: scaleY(1);
      //   @for $i from 1 through 7 {
      //     &:nth-child(#{$i}) {
      //       transition-delay: calc(0.6s + 0.07s * $i);
      //     }
      //   }
      // }
    }
  }

  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-25%);
    }
  }
</style>
