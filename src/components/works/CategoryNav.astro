---
import { getWorkCategoryUrl } from "../../lib/wordpress";

const { categories, currentSlug } = Astro.props;
---

<nav class="bl_categoryNav" aria-label="制作物カテゴリー">
  <ul class="bl_categoryNav_list">
    <li class="bl_categoryNav_item">
      <a
        href="/works"
        class:list={[
          "bl_categoryNav_link font-12-16 ",
          !currentSlug && "bl_categoryNav_link--active",
        ]}
        aria-current={!currentSlug ? "page" : undefined}
      >
        すべて
      </a>
    </li>
    {
      categories.map((category) => {
        const isActive = currentSlug === category.slug;
        return (
          <li class="bl_categoryNav_item">
            <a
              href={getWorkCategoryUrl(category.slug)}
              class:list={[
                "bl_categoryNav_link font-12-16 hl_accentFont",
                isActive && "bl_categoryNav_link--active",
              ]}
              aria-current={isActive ? "page" : undefined}
            >
              {category.name}
              <span class="bl_categoryNav_count">({category.count})</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<style lang="scss">
  @use "../../styles/utility" as *;
  @use "../../styles/global" as *;

  .bl_categoryNav {
    margin-bottom: to-rem(40px);

    &_list {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: fluid-text(10px, 32px);
      list-style: none;
      padding: 0;
      margin: 0;
    }

    &_link {
      display: inline-flex;
      align-items: center;
      gap: to-rem(4px);
      padding: to-rem(8px) to-rem(16px);
      border: solid 1px var(--c-text);
      border-radius: 8px;
      color: var(--c-text);
      text-decoration: none;
      transition: opacity 0.2s ease;
      text-transform: uppercase;

      &:hover {
        opacity: 0.7;
      }

      &--active {
        border-color: $c-orange;
        color: $c-orange;
      }
    }

    &_count {
      opacity: 0.7;
      font-size: 0.875em;
    }
  }
</style>
