---
import ContentPanel from "../ui/ContentPanel.astro";
import { getWorkDetailUrl } from "../../lib/wordpress";

const { work } = Astro.props;
const detailUrl = getWorkDetailUrl(work.id);
const tags = [...(work.tags?.map((tag) => tag.name) ?? [])];
---

<article class="bl_workCard">
  <a href={detailUrl} class="bl_workCard_link">
    {
      work.thumbnailUrl ? (
        <ContentPanel
          title={work.title}
          tags={tags}
          thumbnail={work.thumbnailUrl}
          thumbnailAlt={work.thumbnailAlt}
        />
      ) : (
        <div class="bl_workCard_empty">
          <h3 class="bl_workCard_emptyTitle font-16-24">{work.title}</h3>
          {tags.length > 0 && (
            <ul class="bl_workCard_emptyTags">
              {tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )}
        </div>
      )
    }
  </a>
</article>

<style lang="scss">
  @use "../../styles/utility" as *;
  @use "../../styles/global" as *;

  .bl_workCard {
    height: 100%;

    &_link {
      display: block;
      color: inherit;
      text-decoration: none;
      transition: opacity 0.2s ease;
      height: 100%;
      &:hover {
        opacity: 0.75;
      }
    }

    &_empty {
      display: flex;
      flex-direction: column;
      gap: to-rem(16px);
      min-height: to-rem(200px);
      justify-content: center;
    }

    &_emptyTitle {
      margin: 0;
    }

    &_emptyTags {
      display: flex;
      flex-wrap: wrap;
      gap: to-rem(12px);
      list-style: none;
      padding: 0;
      margin: 0;
      color: #8b8b8b;
    }
  }
</style>
