---
import FlickerText from "../ui/FlickerText.astro";
import Sns from "../common/Sns.astro";
import BilingualTitle from "../ui/BilingualTitle.astro";
import ArrowLink from "../ui/ArrowLink.astro";
---

<section class="bl_hero js_hero">
  <div class="bl_hero_kv">
    <video
      id="js-kv-video"
      class="bl_hero_video kv-img"
      muted
      playsinline
      autoplay
      loop
      data-scroll-trigger="pin,blur,"
      data-pin-trigger=".js_hero"
      preload="auto"
    >
      <source
        media="(max-width: 59.9375em)"
        src="/movie/kv_mobile_converted.mp4"
        type="video/mp4"
      />
      <source src="/movie/kv_converted.mp4" type="video/mp4" />
    </video>
  </div>

  <div class="bl_hero_cover">
    <div class="bl_hero_inner hl_contentWidth">
      <div class="bl_hero_content">
        <p
          data-scroll-trigger="transformSide"
          data-transform-direction="left"
          data-transform-trigger=".bl_hero_cover"
          class="bl_hero_title hl_accentFont"
        >
          PASSION BECOMES<br />
          <FlickerText text="DESIGN." class="hl_accentColor" />
          <br />DESIGN BECOMES<br />
          <FlickerText text="EMOTION." class="hl_accentColor" />
        </p>
        <Sns
          alignItems="flex-start"
          className="bl_hero_sns hl_smHidden hl_accentFont"
          loading="eager"
        />
        <div
          class="bl_hero_object js_hero_object"
          data-scroll-trigger="rotate3dObject"
          data-rotate-trigger=".bl_hero_cover"
          data-webgl="normal"
          data-model="/model/logo.glb"
          data-render-material="standard"
          data-roughness="0.3"
          data-metalness="0.5"
          data-rotation-x="0"
          data-rotation-y="45"
          data-rotation-z="5"
        >
        </div>
        <p
          class="bl_hero_text"
          data-scroll-trigger="transformSide"
          data-transform-direction="right"
          data-transform-trigger=".bl_hero_cover"
        >
          好きという気持ちを原動力に、<br
          />誰かの心を動かすデザインをつくっています。
        </p>
      </div>
      <div class="bl_hero_sub">
        <div class="bl_hero_sub_grid">
          <div class="bl_hero_sub_gridItem grid_1 hl_accentFont">
            <div
              class="hl_webglObject"
              data-webgl="template"
              data-tex-1="/img/grid/grid_1.webp"
              data-mesh-position-z="1"
            >
            </div>
          </div>
          <div class="bl_hero_sub_gridItem grid_2">
            <div
              class="hl_webglObject"
              data-webgl="template"
              data-tex-1="/img/grid/grid_2.webp"
            >
            </div>
          </div>
          <div class="bl_hero_sub_gridItem bl_hero_sub_content grid_3">
            <BilingualTitle
              en="about"
              ja="UCHIWAについて"
              class="bl_hero_sub_title"
            />
            <p class="bl_hero_sub_text font-16-20">
              北海道札幌市の個人事業のWebデザイナー。<br />
              「UCHIWA Creative Studio」という屋号で道内・道外問わず、<br />
              全国のお客様のWebサイト作りに携わらせて頂いております。
            </p>
            <ArrowLink href="/about" class="bl_hero_sub_link" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  //
  const video = document.getElementById("js-kv-video");
  const mq = window.matchMedia("(max-width: 59.9375em)");

  function updateVideoSrc(e) {
    const newSrc = e.matches
      ? "/movie/kv_mobile_converted.mp4"
      : "/movie/kv_converted.mp4";

    if (!video) return;

    if (video.currentSrc !== location.origin + newSrc) {
      video.src = newSrc;
      video.load();
      video.play().catch((err) => {
        console.warn("Autoplay was prevented or interrupted:", err);
      });
    }
  }

  if (video && mq) {
    // Run once on initial load to set the correct src
    updateVideoSrc(mq);
    mq.addEventListener("change", updateVideoSrc);
  }
</script>

<style lang="scss">
  @use "../../styles/utility" as *;
  @use "../../styles/global" as *;

  .bl_hero {
    position: relative;
    &_kv {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      // height: 100svh;
      height: 100lvh;
    }

    @keyframes floating {
      0%,
      100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-15px);
      }
    }

    &_cover {
      width: 100%;
    }
    &_inner {
    }
    &_content {
      width: 100%;
      height: 100svh;
      padding: fluid-px(100px, 140px) 0;
      color: #fff;
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      grid-template-rows: repeat(12, 1fr);
      gap: 0 40px;
      position: relative;

      // グリッド直下の子要素の min-width を 0 にして 1fr が等幅になるよう修正
      & > * {
        min-width: 0;
      }

      @include mq("lg") {
        display: flex;
        flex-direction: column;
        height: auto;
      }
    }
    &_title {
      grid-column: 1 / 7; /* 1列目から5列目まで */
      grid-row: 3 / 7; /* 2行目から9行目まで */
      font-size: fluid-text(30px, 56px, 375px, 1920px);
      // white-space: nowrap;

      @include mq(lg) {
        order: 2;
      }
    }
    &_object {
      grid-column: 5/9;
      grid-row: 5/9;
      max-width: 700px; // fixed width → max-width に変更（グリッド幅を歪めないため）
      width: 100%;
      aspect-ratio: 1;
      align-self: center; // グリッドセル内で上下中央に配置
      justify-self: center;
      animation: floating 2s ease-in-out infinite; // 4秒周期でふわふわさせる
      @include mq(lg) {
        width: 50%;
        max-width: none;
        order: 1;
      }
      @include mq(md) {
        width: calc(300 / 390) * 100%;
      }
    }
    &_text {
      grid-column: 8 / -1;
      grid-row: 11 / -1;
      align-self: end;
      justify-self: end;
      font-size: fluid-text(16px, 24px, 375px, 1920px);
      @include mq(lg) {
        order: 3;
        margin-top: to-rem(24px);
        align-self: start;
      }
    }
    :global(.bl_sns) {
      grid-column: 1/3;
      grid-row: 11/-1;
      align-self: end;
    }

    &_sub {
      width: 100%;
      padding: fluid-text(120px, 160px) 0 to-rem(120px) 0;
      &_grid {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        grid-template-rows: repeat(12, 70px);
        gap: fluid-text(16px, 32px, 375px, 1920px)
          fluid-text(24px, 40px, 375px, 1920px);

        @include mq("lg") {
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: to-rem(40px);
        }

        .grid_1 {
          grid-column: 1/5;
          grid-row: 2/11;
          aspect-ratio: 560/784;
          z-index: 2;
          &:after {
            content: "UCHIWA";
            font-size: fluid-text(60px, 120px, 375px, 1920px);
            color: var(--c-white);
            mix-blend-mode: soft-light;
            position: absolute;
            right: 0;
            top: 100%;
            transform: translate(30%, -45%);
            font-weight: 900;
            opacity: 0.3;
          }

          @include mq("lg") {
            order: 1;
            width: calc(300 / 390) * 100%;
          }
        }
        .grid_2 {
          width: 100%;
          aspect-ratio: 1010/682;
          display: block;
          grid-column: 3/10;
          grid-row: 1/8;
          z-index: 1;
          position: relative;
          transform: none;

          @include mq("lg") {
            position: absolute;
            transform: translateY(-500%);
          }
        }
        .grid_3 {
          grid-column: 7/-1;
          grid-row: 7/-1;
          // align-self: end;
          z-index: 3;
          @include mq("lg") {
            order: 2;
            width: 100%;
          }
        }
      }
      &_gridItem {
        position: relative;
        object-fit: cover;
        img {
          width: 100%;
        }
      }
      &_content {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
      }
      &_text {
        margin-top: fluid-text(30px, 40px);
        line-height: 2;
      }
      :global(.el_link) {
        margin-top: fluid-text(48px, 64px);
      }
    }
  }

  #js-kv-video {
    position: relative;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    // aspect-ratio: 16/9;
    object-fit: cover;
    z-index: -2;
    pointer-events: none;
  }
</style>
