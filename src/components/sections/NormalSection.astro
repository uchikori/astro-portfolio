---
import SectionTitle from "../ui/SectionTitle.astro";
const { title, contents, tag: Tag = "h2", class: className = "" } = Astro.props;
---

<section class:list={["bl_section", className]}>
  {
    title ? (
      <SectionTitle title={title} tag={Tag} class:list={["font-24-32"]} />
    ) : (
      <SectionTitle tag={Tag} class:list={["font-24-32"]}>
        <slot name="title" />
      </SectionTitle>
    )
  }
  {
    contents ? (
      <p class="bl_section_contents" set:html={contents} />
    ) : (
      <div class="bl_section_contents">
        <slot />
      </div>
    )
  }
</section>

<style lang="scss">
  @use "../../styles/utility" as *;
  @use "../../styles/global" as *;

  $base: ".bl_section";

  :global(.bl_section) {
    display: flex;
    flex-direction: column;
    gap: fluid-text(24px, 80px);
  }

  :global(.bl_section_title) {
    font-weight: 500;
  }
</style>
