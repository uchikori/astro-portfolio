---
import BilingualTitle from "../ui/BilingualTitle.astro";
import ArrowLink from "../ui/ArrowLink.astro";
import Card from "../ui/Card.astro";
import thumbnail from "../../assets/img/blog/blog_1.png";
import BilingualBtn from "../ui/BilingualBtn.astro";
import { fetchBlogPosts } from "../../lib/wordpress";
import BlogCard from "../blog/BlogCard.astro";

const page = 1;
const perPage = 8;
const { posts, total, totalPages, currentPage } = await fetchBlogPosts({
  page,
  perPage,
});
---

