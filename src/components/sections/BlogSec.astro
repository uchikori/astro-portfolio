<style lang="scss">
  @use "../../styles/utility" as *;
  @use "../../styles/global" as *;

  .bl_blog {
    padding: fluid-text(120px, 160px) 0;
    &_header {
      display: flex;
      align-items: flex-end;
      gap: fluid-text(30px, 100px);
      @include mq("lg") {
        :global(.el_link) {
          display: none;
        }
      }
    }
    &_list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(to-rem(300px), 1fr));
      gap: fluid-text(40px, 80px) to-rem(40px);
      margin-top: fluid-text(30px, 80px);
    }
    &_item {
      a {
        width: 100%;
        height: 100%;
        display: block;
      }
    }
    :global(.el_bilingualBtn) {
      margin-top: fluid-text(30px, 80px);
    }
  }
</style>
