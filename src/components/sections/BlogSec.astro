    <div class="bl_blog_header">
      <BilingualTitle en="Blog" ja="ブログ" class="bl_blog_title" />
      <ArrowLink href="/web-tips/" />
    </div>
    <ul class="bl_blog_list">
      {
        posts.map((post) => (
          <li class="bl_blog_item">
            <BlogCard post={post} />
          </li>
        ))
      }
      <!-- <li class="bl_blog_item">
