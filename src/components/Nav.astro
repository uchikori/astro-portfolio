<style lang="scss">
  @use "../styles/utility" as *;
  @use "../styles/global" as *;

  .bl_nav {
    :global(.bl_footer) & {
      width: 100%;
    }
    &_ul {
      // header配下の場合
      :global(.bl_header) & {
        // display: flex;
        // flex-direction: column;
        gap: 0.5em;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(to-rem(300px), 1fr));
      }

      // フッター配下の場合
      :global(.bl_footer) & {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(to-rem(300px), 1fr));
        gap: to-rem(32px) to-rem(40px);
      }
    }

    &_li {
      list-style: none;

      // header配下の場合
      :global(.bl_header) & {
        opacity: 0;
        transform: scaleY(0);
        transform-origin: bottom;
        transition:
          transform 0.2s,
          opacity 0.2s;
      }

      :global(.js_menu_open) & {
        opacity: 1;
        transform: scaleY(1);
        @for $i from 1 through 7 {
          &:nth-child(#{$i}) {
            transition-delay: calc(0.6s + 0.07s * $i);
          }
        }
      }
    }

    & a {
      position: relative;
      width: 100%;
      display: flex;
      // デフォルト（PC）は2列。7emで固定することで英語ラベルの頭が揃います。
      // grid-template-columns: repeat(auto-fit, minmax(7em, 1fr));
      color: var(--c-dark);
      text-decoration: none;
      transition: transform 0.4s ease;
      @media screen and (max-width: 389px) {
        flex-direction: column;
      }

      & > span:first-child {
        min-width: 7em;
        display: block;
        position: relative;

        @media (hover: hover) {
          overflow: hidden;
          white-space: nowrap;

          &::after {
            content: attr(data-text) "\a0\a0\a0" attr(data-text) "\a0\a0\a0"
              attr(data-text) "\a0\a0\a0" attr(data-text) "\a0\a0\a0";
            position: absolute;
            left: 0;
            top: 0;
            width: max-content;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s;
          }
        }
      }

      @media (hover: hover) {
        &:hover > span:first-child {
          color: transparent;

          &::after {
            opacity: 1;
            color: var(--c-orange);
            animation: marquee 3s linear infinite;
          }
        }
      }

      & > span:nth-child(2) {
        font-size: 0.5em;
        display: flex;
        align-items: center;
        flex: 1 1 auto;
        gap: 12px;

        &:before {
          content: "";
          width: 1em;
          height: 1px;
          background-color: currentColor;
          display: inline-block;
          opacity: 0.6;
        }
      }

      :global(.bl_footer) & {
        color: var(--c-white);
      }
    }

    &_li:hover a {
      color: #868686;
      transform: translateX(5%);
    }
  }
</style>
